# Ornith XPU graphs canary — shared profile (all arms)
MODEL=/models/Ornith-1.0-35B-MXFP4
SERVED=ornith-canary
PORT=8021
MAX_MODEL_LEN=32768
MAX_NUM_BATCHED_TOKENS=4096   # Mamba page align >= 2112; keep parity with prod
MAX_NUM_SEQS=2
GPU_UTIL=0.85
DTYPE=bfloat16
KV_CACHE_DTYPE=fp8
ZE_AFFINITY_MASK=0
READY_TIMEOUT=3600

# Arm A — eager baseline (mirrors production; graphs off)
#VLLM_XPU_ENABLE_XPU_GRAPH=0
# serve args: --enforce-eager

# Arm B — PIECEWISE (01 clamp keeps FA + GDN outside capture)
#VLLM_XPU_ENABLE_XPU_GRAPH=1
#VLLM_XPU_GRAPH_FORCE_PIECEWISE=1
# serve args: --attention-backend FLASH_ATTN -cc.cudagraph_mode=PIECEWISE

# Arm C — FA-in-graph FULL (03 opt-out; needs oneAPI 2026.0+ runtime)
#VLLM_XPU_ENABLE_XPU_GRAPH=1
#VLLM_XPU_GRAPH_FORCE_PIECEWISE=0
# serve args: --attention-backend FLASH_ATTN -cc.cudagraph_mode=FULL

# Production Ornith (UNCHANGED, for reference only — do not copy canary flags):
#   VLLM_XPU_ENABLE_XPU_GRAPH=0
#   vllm serve ... --enforce-eager
