# FA-in-graph canary profile — use with a SEPARATE DS/Job from Ornith.
# Source this file or copy keys into the canary pod env.

VLLM_XPU_ENABLE_XPU_GRAPH=1
VLLM_XPU_GRAPH_FORCE_PIECEWISE=0
ZE_AFFINITY_MASK=0

# Serve args (splice into container command; omit --enforce-eager):
#   --attention-backend FLASH_ATTN
#   -cc.cudagraph_mode=FULL
#   --max-model-len 4096
#   --gpu-memory-utilization 0.85
#   --dtype bfloat16

# Rollback (canary only):
#   VLLM_XPU_GRAPH_FORCE_PIECEWISE=1   # -> 01 PIECEWISE
#   or VLLM_XPU_ENABLE_XPU_GRAPH=0 + add --enforce-eager
