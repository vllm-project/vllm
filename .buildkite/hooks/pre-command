#!/bin/bash
# Branch-scoped diagnostic for the CPU image-build heartbeat baseline. Not for merge.
#
# Lesson from takes 1-3: the agent reaps the hook's process group when the hook
# phase ends, so plain background loops die before their first ship. The sampler
# and shipper are therefore fully detached with setsid, and a FOREGROUND probe
# runs inside the hook so upload capability (or its failure reason) lands in the
# job log before the command phase starts.
if [[ "${BUILDKITE_STEP_KEY:-}" == "image-build" ]]; then
  echo "HBSAMPLE hook context: $(which buildkite-agent) | bk env vars: $(env | grep -c '^BUILDKITE')"
cat > /tmp/ena_stats.py <<'PYEOF'
import array, fcntl, socket, struct, sys
# Read ethtool NIC stats via SIOCETHTOOL ioctl - no ethtool binary needed.
SIOCETHTOOL = 0x8946
ETHTOOL_GSSET_INFO = 0x37
ETHTOOL_GSTRINGS = 0x1B
ETHTOOL_GSTATS = 0x1D
ETH_SS_STATS = 1

def ena_stats(iface):
    sk = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    # number of stats
    sset = struct.pack("IIQI", ETHTOOL_GSSET_INFO, 0, 1 << ETH_SS_STATS, 0)
    buf = array.array("b", sset + b"\x00" * 4)
    ifr = struct.pack("16sP", iface.encode(), buf.buffer_info()[0])
    fcntl.ioctl(sk.fileno(), SIOCETHTOOL, ifr)
    n = struct.unpack_from("I", bytes(buf), 16)[0]
    if not n:
        return {}
    # names
    gstr = struct.pack("III", ETHTOOL_GSTRINGS, ETH_SS_STATS, n)
    buf = array.array("b", gstr + b"\x00" * (32 * n))
    ifr = struct.pack("16sP", iface.encode(), buf.buffer_info()[0])
    fcntl.ioctl(sk.fileno(), SIOCETHTOOL, ifr)
    raw = bytes(buf)[12:]
    names = [raw[i*32:(i+1)*32].split(b"\x00")[0].decode() for i in range(n)]
    # values
    gst = struct.pack("II", ETHTOOL_GSTATS, n)
    buf = array.array("b", gst + b"\x00" * (8 * n))
    ifr = struct.pack("16sP", iface.encode(), buf.buffer_info()[0])
    fcntl.ioctl(sk.fileno(), SIOCETHTOOL, ifr)
    vals = struct.unpack_from(f"{n}Q", bytes(buf), 8)
    return dict(zip(names, vals))

iface = sys.argv[1]
stats = ena_stats(iface)
hits = {k: v for k, v in stats.items() if "allowance" in k or "conntrack" in k}
print(" ".join(f"{k}={v}" for k, v in sorted(hits.items())) or f"NO_ALLOWANCE_STATS total={len(stats)}")
PYEOF
  IF0=$(ls /sys/class/net/ 2>/dev/null | grep -E '^(ens|eth)' | head -1)
  echo "HBSAMPLE ena probe: $(python3 /tmp/ena_stats.py "$IF0" 2>&1 | head -c 400)"
  echo "hb probe $(date -u +%FT%TZ)" > /tmp/hb-probe.log
  (cd /tmp && buildkite-agent artifact upload hb-probe.log)
  echo "HBSAMPLE foreground probe upload exit=$?"

  cat > /tmp/hb-sampler.sh <<'INNER'
#!/bin/bash
SFILE=/tmp/hbsample.log
AGENT_CG=$(systemctl show buildkite-agent -p ControlGroup --value 2>/dev/null)
BKD_CG=$(systemctl show buildkitd -p ControlGroup --value 2>/dev/null)
sample() {
  echo "HBSAMPLE t=$(date -u +%FT%TZ) up=$(cut -d' ' -f1 /proc/uptime) load=$(cut -d' ' -f1-3 /proc/loadavg)"
  echo "HBSAMPLE stat=$(head -1 /proc/stat)"
  echo "HBSAMPLE cpu_psi=$(tr '\n' ' ' < /proc/pressure/cpu 2>/dev/null)"
  echo "HBSAMPLE io_psi=$(tr '\n' ' ' < /proc/pressure/io 2>/dev/null)"
  echo "HBSAMPLE mem_psi=$(tr '\n' ' ' < /proc/pressure/memory 2>/dev/null)"
  echo "HBSAMPLE agent_svc=$(systemctl show buildkite-agent -p NRestarts,ActiveEnterTimestamp,SubState,Nice,CPUWeight 2>/dev/null | tr '\n' ' ')"
  echo "HBSAMPLE bkd_svc=$(systemctl show buildkitd -p NRestarts,ActiveEnterTimestamp,SubState,Nice,CPUWeight 2>/dev/null | tr '\n' ' ')"
  [ -n "$AGENT_CG" ] && echo "HBSAMPLE agent_cpustat=$(tr '\n' ' ' < "/sys/fs/cgroup${AGENT_CG}/cpu.stat" 2>/dev/null) agent_weight=$(cat "/sys/fs/cgroup${AGENT_CG}/cpu.weight" 2>/dev/null)"
  [ -n "$BKD_CG" ] && echo "HBSAMPLE bkd_cpustat=$(tr '\n' ' ' < "/sys/fs/cgroup${BKD_CG}/cpu.stat" 2>/dev/null) bkd_weight=$(cat "/sys/fs/cgroup${BKD_CG}/cpu.weight" 2>/dev/null)"
  echo "HBSAMPLE net_http=$(curl -s -o /dev/null -w '%{http_code}:%{time_total}' --max-time 3 https://agent.buildkite.com/v3 2>/dev/null || echo FAIL)"
  echo "HBSAMPLE net_dev=$(grep -E 'ens|eth' /proc/net/dev 2>/dev/null | head -1 | tr -s ' ')"
  IFACE=$(ls /sys/class/net/ 2>/dev/null | grep -E '^(ens|eth)' | head -1)
      echo "HBSAMPLE ena=$(python3 /tmp/ena_stats.py "$(ls /sys/class/net/ | grep -E '^(ens|eth)' | head -1)" 2>/dev/null)"
  echo "HBSAMPLE sockstat=$(head -2 /proc/net/sockstat 2>/dev/null | tr '\n' ' ')"
  echo "HBSAMPLE conntrack_count=$(cat /proc/sys/net/netfilter/nf_conntrack_count 2>/dev/null || echo n/a)/$(cat /proc/sys/net/netfilter/nf_conntrack_max 2>/dev/null || echo n/a)"
}
n=0
while true; do
  sample >> "$SFILE" 2>/dev/null
  n=$((n+1))
  if [ $((n % 3)) -eq 0 ]; then
    cp "$SFILE" /tmp/hbsample-latest.log
    (cd /tmp && buildkite-agent artifact upload hbsample-latest.log \
      >> /tmp/hbship.log 2>&1) || echo "ship $n failed $?" >> /tmp/hbship.log
    cp /tmp/hbship.log /tmp/hbsample-shiplog.log 2>/dev/null
    (cd /tmp && buildkite-agent artifact upload hbsample-shiplog.log >/dev/null 2>&1)
  fi
  sleep 10
done
INNER
  chmod +x /tmp/hb-sampler.sh
  setsid nohup env BUILDKITE_AGENT_ACCESS_TOKEN="$BUILDKITE_AGENT_ACCESS_TOKEN" \
    BUILDKITE_JOB_ID="$BUILDKITE_JOB_ID" \
    BUILDKITE_AGENT_ENDPOINT="${BUILDKITE_AGENT_ENDPOINT:-}" \
    /tmp/hb-sampler.sh > /tmp/hb-sampler-out.log 2>&1 < /dev/null &
  disown
  echo "HBSAMPLE detached sampler started"
fi
