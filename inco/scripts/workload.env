# Pinned workload + server configuration for the Inco baseline.
# Source this before serve_baseline.sh or run_baseline.sh.
#
# Shared by both sides of the benchmark so server flags and aiperf flags cannot
# drift. The INCO_* names are read directly by bench/config.py.

# ---- Model / workload -------------------------------------------------------
export INCO_MODEL="${INCO_MODEL:-Qwen/Qwen3-30B-A3B-Instruct-2507}"
export INCO_ISL="${INCO_ISL:-1024}"          # input tokens per request
export INCO_OSL="${INCO_OSL:-256}"           # output tokens per request (pinned)
export INCO_NUM_GPUS="${INCO_NUM_GPUS:-1}"   # == tensor parallel size
export INCO_RANDOM_SEED="${INCO_RANDOM_SEED:-100}"

# ---- Server -----------------------------------------------------------------
# Sized for one 80GB H100. Qwen3-30B-A3B is 30.5B total / 3.3B active, so bf16
# weights take ~61GB and leave only ~7GB for KV cache -- about 96 KiB/token
# (48 layers x 4 KV heads x 128 head_dim x 2 for K+V x 2 bytes), so ~76k tokens
# but the KV cache is pinned below (INCO_KV_CACHE_GIB), giving ~102 resident
# requests at ISL+OSL=1280 regardless of which H100 variant we land on. The
# client verifies the real number against /server_info before measuring.
#
# On an H200 (141GB) or with TP=2, raise INCO_MAX_NUM_SEQS and
# INCO_CONCURRENCIES to 256 -- there is ~60GB of KV cache to work with.
export INCO_PORT="${INCO_PORT:-8000}"
export INCO_HOST="${INCO_HOST:-0.0.0.0}"
export INCO_URL="${INCO_URL:-http://localhost:${INCO_PORT}}"
export INCO_MAX_NUM_SEQS="${INCO_MAX_NUM_SEQS:-64}"
export INCO_MAX_NUM_BATCHED_TOKENS="${INCO_MAX_NUM_BATCHED_TOKENS:-8192}"
export INCO_MAX_MODEL_LEN="${INCO_MAX_MODEL_LEN:-4096}"
export INCO_GPU_MEMORY_UTILIZATION="${INCO_GPU_MEMORY_UTILIZATION:-0.90}"
# Pin the KV cache instead of letting it fall out of gpu-memory-utilization.
# A provider can hand out H100 80GB HBM3 or H100 NVL (94GB) for the same
# request; at util 0.90 those leave ~12.5GiB and ~25GiB of KV respectively,
# which doubles servable concurrency and makes two runs incomparable. 12GiB
# fits the smaller variant and holds ~131k tokens (~102 requests at ISL+OSL
# 1280). Set to 0 to go back to utilization-derived sizing.
export INCO_KV_CACHE_GIB="${INCO_KV_CACHE_GIB:-12}"
export INCO_DTYPE="${INCO_DTYPE:-bfloat16}"

# ---- Sweep ------------------------------------------------------------------
export INCO_LABEL="${INCO_LABEL:-baseline}"
export INCO_CONCURRENCIES="${INCO_CONCURRENCIES:-1,2,4,8,16,32,64}"
export INCO_REQUESTS_PER_CONCURRENCY="${INCO_REQUESTS_PER_CONCURRENCY:-8}"
export INCO_MIN_REQUESTS="${INCO_MIN_REQUESTS:-24}"
# A guard against absurd values, not a binding cap. At 1024 it bound for
# every concurrency >= 128, so waves decayed as 1024/c -- by c=448 the
# unwarmed first wave was 44% of the sample and tokens/s/user came out
# non-monotonic, i.e. physically impossible.
export INCO_MAX_REQUESTS="${INCO_MAX_REQUESTS:-100000}"
# 16, not 8: at concurrency 1 a single cold request (643ms TTFT vs a 68ms
# median) pulled the reported mean 36% high in the smoke run.
export INCO_WARMUP_REQUESTS="${INCO_WARMUP_REQUESTS:-16}"

# ---- vLLM runtime -----------------------------------------------------------
# Dev mode exposes /server_info (records the effective VllmConfig with the
# results) and /reset_prefix_cache (cold KV cache per concurrency point).
export VLLM_SERVER_DEV_MODE="${VLLM_SERVER_DEV_MODE:-1}"
export VLLM_LOGGING_LEVEL="${VLLM_LOGGING_LEVEL:-INFO}"
