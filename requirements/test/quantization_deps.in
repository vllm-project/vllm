# Packages only the Quantization CI steps use, installed into /opt/quantization-deps in
# the CUDA 13 test image (docker/Dockerfile, test-deps stage) instead of site-packages.
# The Quantization steps put that folder on PYTHONPATH; other jobs never see it.
# - torchao: transformers imports it whenever it is installed, and torchao checks the
#   GPU at import, which initializes CUDA in the pytest process and breaks tests that fork.
# - conch-triton-kernels: vLLM picks the Conch kernel whenever the package is installed,
#   which would change the mixed-precision kernel other jobs run.
# Their dependencies are already in requirements/test/cuda.txt, so the lock holds these
# two alone (--no-deps).
torchao==0.18.0
conch-triton-kernels==1.3
