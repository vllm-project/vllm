#: ../../source/mp/http_api.rst:802
msgid "**Query parameters:**"
msgstr "**查询参数：**"

#: ../../source/mp/http_api.rst:808
msgid "Name"
msgstr "名称"

#: ../../source/mp/http_api.rst:812
msgid "primary"
msgstr "主适配器"

#: ../../source/mp/http_api.rst:813
