msgstr "同一块的连续访问（读取或写入）之间的时间间隔。"

#: ../../source/mp/observability/metrics.rst:119
msgid "``lmcache_mp.l1_chunk_evict_reuse_gap``"
msgstr "``lmcache_mp.l1_chunk_evict_reuse_gap``"

#: ../../source/mp/observability/metrics.rst:121
