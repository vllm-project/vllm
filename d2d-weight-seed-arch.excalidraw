   "updated": 1,
   "link": null,
   "locked": false,
   "text": "mirror daemons = ordinary daemons (no special case)\n- load_format=\"peer_cache\" (injected by preload)\n- own world group, meta-built model\n- same warmup as source (adopt or tune in place)\n- identical serving; can seed others (chained seed)",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e011180c2862",
   "originalText": "mirror daemons = ordinary daemons (no special case)\n- load_format=\"peer_cache\" (injected by preload)\n- own world group, meta-built model\n- same warmup as source (adopt or tune in place)\n- identical serving; can seed others (chained seed)",
   "lineHeight": 1.25
  },
