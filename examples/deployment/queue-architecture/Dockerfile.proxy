# Multi-stage build for proxy binary
# Stage 1: Builder
FROM golang:1.24-alpine AS builder

WORKDIR /app

# Copy dependency files and vendored dependencies
COPY go.mod go.sum ./
COPY vendor ./vendor

# Copy source code
COPY . .

# Build the proxy binary with CGO disabled for portability
# Use -mod=vendor to build from vendored dependencies (no network access needed)
RUN CGO_ENABLED=0 go build -mod=vendor -o /app/proxy ./cmd/proxy

# Stage 2: Runtime
FROM gcr.io/distroless/base-debian12:nonroot

# Copy the compiled binary from builder
COPY --from=builder /app/proxy /app/proxy

# Set the entrypoint
ENTRYPOINT ["/app/proxy"]
