          "sort": "desc"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Mean acceptance length",
      "description": "Tokens produced per verification step (1 + accepted / drafts), per model.\n\nMetrics: `vllm:spec_decode_num_accepted_tokens_total`, `vllm:spec_decode_num_drafts_total`",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "1 + sum by (model_name) (rate(vllm:spec_decode_num_accepted_tokens_total{job=~\"$job\", model_name=~\"$model_name\", instance=~\"$instance\", engine=~\"$engine\"}[$__rate_interval])) / (sum by (model_name) (rate(vllm:spec_decode_num_drafts_total{job=~\"$job\", model_name=~\"$model_name\", instance=~\"$instance\", engine=~\"$engine\"}[$__rate_interval])) > 0)",
          "format": "time_series",
          "instant": false,
