        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "1 - (sum(rate(vllm:request_success_total{job=~\"$job\", model_name=~\"$model_name\", instance=~\"$instance\", finished_reason=\"error\"}[5m])) / (sum(rate(vllm:request_success_total{job=~\"$job\", model_name=~\"$model_name\", instance=~\"$instance\"}[5m])) > 0))",
          "legendFormat": "__auto",
