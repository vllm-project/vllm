      "targets": [
        {
          "expr": "sum(rate(vllm:generation_tokens_total{job=~\"$job\", model_name=~\"$model_name\", instance=~\"$instance\"}[5m])) / (sum(avg_over_time(vllm:num_requests_running{job=~\"$job\", model_name=~\"$model_name\", instance=~\"$instance\"}[5m])) > 0)",
          "legendFormat": "__auto",
