# syntax=docker/dockerfile:1
# vLLM on ROCm, shared by both stacks. Build it with docker/docker-bake-rocm.hcl, which provides the
# `stack` named context (the `final` stage of docker/Dockerfile.rocm_base)
# and optionally prebuilt `runtime` and `test-deps` images.
# Everything above the per-commit marker is hashed into the runtime key by .buildkite/scripts/rocm/build.sh.
ARG ROCM_TRITON_KERNELS_COMMIT=669b31acc1dd1b3fd93286afd5db67f65d9f7557

FROM stack AS dev
# Build tools plus the runtime system packages (RDMA userspace, FFmpeg for torchcodec).
# mold is installed but not the default linker: some packages JIT-compile at runtime
# with flags mold does not support. Build stages opt in via LDFLAGS="-fuse-ld=mold".
RUN apt-get update -q -y -o Acquire::Retries=3 && apt-get install -q -y -o Acquire::Retries=3 \
    sqlite3 libsqlite3-dev libfmt-dev libmsgpack-dev libsuitesparse-dev \
    apt-transport-https ca-certificates wget curl libnuma-dev ccache mold \
    librdmacm1 libibverbs1 ibverbs-providers ibverbs-utils util-linux unzip libsodium23 \
    pkg-config ffmpeg libavcodec-dev libavformat-dev libavutil-dev \
    libswscale-dev libavdevice-dev libavfilter-dev libswresample-dev \
    && rm -rf /var/lib/apt/lists/*
RUN --mount=type=cache,target=/root/.cache/pip \
    python3 -m pip install --upgrade pip
# Download first, then run, so a curl failure is not masked by the pipe
RUN curl -LsSf --retry 3 --retry-delay 5 https://astral.sh/uv/install.sh -o /tmp/uv-install.sh \
    && env UV_INSTALL_DIR="/usr/local/bin" sh /tmp/uv-install.sh \
    && rm -f /tmp/uv-install.sh \
    && uv --version
# Some dependencies time out with uv's default; see https://github.com/astral-sh/uv/pull/1694
ENV UV_HTTP_TIMEOUT=500
ENV UV_INDEX_STRATEGY="unsafe-best-match"
# Use copy mode to avoid hardlink failures with Docker cache mounts
ENV UV_LINK_MODE=copy
ENV CCACHE_DIR=/root/.cache/ccache
ENV CCACHE_COMPILERCHECK=content
RUN --mount=type=cache,id=vllm-rocm-uv,target=/root/.cache/uv \
    uv pip install --system -c /etc/rocm-constraints.txt cmake ninja "setuptools<80" setuptools-scm \
        setuptools-rust wheel jinja2 packaging

# NIXL/UCX build stages
FROM dev AS build_nixl
ARG NIXL_BRANCH="1683cf3b7f3d11674c03c5e861cea22339876c96"
ARG NIXL_REPO="https://github.com/ai-dynamo/nixl.git"
ARG UCX_BRANCH="2ff0b47ce7626584cb9b56c647d08f712c6c3edf"
ARG UCX_REPO="https://github.com/openucx/ucx.git"
ENV UCX_HOME=/usr/local/ucx
ENV NIXL_HOME=/usr/local/nixl

# NIXL build system dependencies and RDMA support
RUN apt-get -y update && apt-get -y install autoconf libtool pkg-config \
    libgrpc-dev \
    libgrpc++-dev \
    libprotobuf-dev \
    protobuf-compiler-grpc \
    libcpprest-dev \
    libaio-dev \
    librdmacm1 \
    librdmacm-dev \
    libibverbs1 \
    libibverbs-dev \
    ibverbs-utils \
    rdmacm-utils \
    ibverbs-providers \
    && rm -rf /var/lib/apt/lists/*

RUN --mount=type=cache,id=vllm-rocm-uv,target=/root/.cache/uv \
    uv pip install --system meson meson-python pyyaml types-PyYAML \
        auditwheel build patchelf pytest tomlkit "setuptools>=80.9.0"

RUN --mount=type=cache,target=/root/.cache/ccache \
    cd /usr/local/src && \
    git clone ${UCX_REPO} &&  \
    cd ucx  && \
    git checkout ${UCX_BRANCH} && \
    ./autogen.sh && \
    mkdir build && cd build && \
    CC="ccache gcc" CXX="ccache g++" \
    ../configure \
        --prefix=/usr/local/ucx \
        --enable-shared \
        --disable-static \
        --disable-doxygen-doc \
        --enable-optimizations \
        --enable-devel-headers \
        --with-rocm=${ROCM_PATH} \
        --with-verbs \
        --with-dm \
        --enable-mt && \
    make -j$(nproc) && \
    make install

ENV PATH=/usr/local/ucx/bin:$PATH
ENV LD_LIBRARY_PATH=${UCX_HOME}/lib:${LD_LIBRARY_PATH}

RUN --mount=type=cache,target=/root/.cache/ccache \
    git clone ${NIXL_REPO} /opt/nixl && \
    cd /opt/nixl && \
    git checkout ${NIXL_BRANCH} && \
    CC="ccache gcc" CXX="ccache g++" \
    meson setup build --prefix=${NIXL_HOME} \
                     -Ducx_path=${UCX_HOME} \
                     -Dwheel_variant=rocm \
                     -Dbuild_tests=false \
                     -Dbuild_examples=false && \
    cd build && \
    ninja -j$(nproc) && \
    ninja install && \
    echo "${NIXL_HOME}/lib/$(uname -m)-linux-gnu" \
        > /etc/ld.so.conf.d/nixl.conf && \
    echo "${NIXL_HOME}/lib/$(uname -m)-linux-gnu/plugins" \
        >> /etc/ld.so.conf.d/nixl.conf && \
    ldconfig

# Generate the ROCm NIXL wheel. Upstream's generic wheel helper detects CUDA,
# so configure the ROCm wheel variant directly through Meson.
# Exclude libcore and libpull from auditwheel: transitive dependencies
# that are not shipped in the wheel and vary across base images.
# Tag manylinux_2_35 to match the Ubuntu 22.04 base: NIXL >= 1.5 links
# GLIBCXX_3.4.30 symbols, which manylinux_2_34 does not allow.
RUN cd /opt/nixl && \
    ./contrib/tomlutil.py --wheel-name nixl-rocm pyproject.toml && \
    CC="ccache gcc" CXX="ccache g++" \
    uv build --wheel --no-build-isolation --out-dir /tmp/nixl_wheels \
        --python ${PYTHON_VERSION} \
        -Csetup-args=-Ducx_path=${UCX_HOME} \
        -Csetup-args=-Dwheel_variant=rocm \
        -Csetup-args=-Dbuild_tests=false \
        -Csetup-args=-Dbuild_examples=false && \
    mkdir -p /tmp/nixl_wheels/repaired /app/install && \
    auditwheel repair \
        --exclude 'libamdhip64*' \
        --exclude 'libcore*' \
        --exclude 'libpull*' \
        /tmp/nixl_wheels/nixl_rocm*.whl \
        --plat manylinux_2_35_$(uname -m) \
        --wheel-dir /tmp/nixl_wheels/repaired && \
    ./contrib/wheel_add_ucx_plugins.py \
        --ucx-plugins-dir ${UCX_HOME}/lib/ucx \
        --nixl-plugins-dir ${NIXL_HOME}/lib/$(uname -m)-linux-gnu/plugins \
        /tmp/nixl_wheels/repaired/*.whl && \
    cp /tmp/nixl_wheels/repaired/*.whl /app/install

# Fetch and verify pinned LMCache source.
FROM dev AS lmcache_source
ARG LMCACHE_REPO="https://github.com/LMCache/LMCache.git"
ARG LMCACHE_REF="140819c9d57a975dbc5678a6459a218e544cb58b"
ARG LMCACHE_VERSION="0.5.3"

# Remove NVIDIA-only dependencies and accept the release image's NumPy version.
RUN printf '%s\n' "${LMCACHE_REF}" | grep -Eq '^[0-9a-f]{40}$' \
    && git clone --depth=1 --branch "v${LMCACHE_VERSION}" \
        "${LMCACHE_REPO}" /app/lmcache \
    && test "$(git -C /app/lmcache rev-parse HEAD)" = "${LMCACHE_REF}" \
    && test "$(grep -Ec '^(cufile-python|nvtx)([<=>[:space:]]|$)' \
        /app/lmcache/requirements/common.txt)" -eq 2 \
    && test "$(grep -Fxc 'numpy<=2.2.6' \
        /app/lmcache/requirements/common.txt)" -eq 1 \
    && sed -i -E \
        -e '/^(cufile-python|nvtx)([<=>[:space:]]|$)/d' \
        -e 's/^numpy<=2\.2\.6$/numpy<=2.3.5/' \
        /app/lmcache/requirements/common.txt \
    && rm -rf /app/lmcache/.git

FROM dev AS build_lmcache
COPY --from=lmcache_source \
    /app/lmcache/requirements/build.txt /tmp/lmcache-build-requirements.txt
RUN --mount=type=cache,id=vllm-rocm-uv,target=/root/.cache/uv \
    uv pip install --system -r /tmp/lmcache-build-requirements.txt

ARG LMCACHE_VERSION="0.5.3"
ARG LMCACHE_ROCM_ARCH="gfx942;gfx950"

COPY --from=lmcache_source /app/lmcache /app/lmcache
WORKDIR /app/lmcache

RUN --mount=type=cache,id=vllm-rocm-ccache,target=/root/.cache/ccache \
    set -eu; \
    printf '%s\n' "${LMCACHE_ROCM_ARCH}" \
        | grep -Eq '^gfx[0-9a-z]+(;gfx[0-9a-z]+)*$'; \
    offload_flags="$(printf '%s' "${LMCACHE_ROCM_ARCH}" \
        | sed 's/;/ --offload-arch=/g; s/^/--offload-arch=/')"; \
    mkdir -p /app/install; \
    SETUPTOOLS_SCM_PRETEND_VERSION="${LMCACHE_VERSION}" \
    PYTORCH_ROCM_ARCH="${LMCACHE_ROCM_ARCH}" \
    HIPCC_COMPILE_FLAGS_APPEND="${offload_flags}" \
    BUILD_WITH_HIP=1 CXX=hipcc \
        python3 setup.py bdist_wheel --dist-dir=/app/install; \
    test "$(find /app/install -maxdepth 1 -name '*.whl' | wc -l)" -eq 1

RUN --mount=type=tmpfs,target=/tmp/lmcache-wheel \
    set -eu; \
    python3 -m zipfile -e /app/install/*.whl /tmp/lmcache-wheel; \
    c_ops="$(find /tmp/lmcache-wheel -type f -name 'c_ops*.so')"; \
    test "$(find /tmp/lmcache-wheel -type f -name 'c_ops*.so' | wc -l)" -eq 1; \
    expected="$(printf '%s' "${LMCACHE_ROCM_ARCH}" | tr ';' '\n' | sort -u)"; \
    actual="$(llvm-objdump --offloading "${c_ops}" \
        | grep -oE 'gfx[0-9a-z]+' | sort -u)"; \
    if [ "${actual}" != "${expected}" ]; then \
        printf 'LMCache code objects mismatch\nexpected:\n%s\nactual:\n%s\n' \
            "${expected}" "${actual}" >&2; \
        exit 1; \
    fi

# DeepEP build stage. The stack sets ROCSHMEM_DIR via the TheRock SDK.
FROM dev AS build_deepep
ARG DEEPEP_BRANCH="0f63d3e9"
ARG DEEPEP_REPO="https://github.com/ROCm/DeepEP.git"
ARG DEEPEP_NIC="cx7"

# Build DeepEP wheel. DeepEP looks for rocshmem at ROCSHMEM_DIR.
# DeepEP only supports gfx942 and gfx950, so avoid gfx90a in the default list.
# We pass --rocm-gfx942-fp8-fnuz-max 224 to align the DeepEP dispatch FP8
# quantization bound with vLLM's own clamp
# (vllm/model_executor/layers/quantization/utils/fp8_utils.py): 224 for E4M3FNUZ
RUN --mount=type=cache,target=/root/.cache/ccache \
    export PYTORCH_ROCM_ARCH="gfx942;gfx950" \
 && git clone ${DEEPEP_REPO} \
 && cd DeepEP \
 && git checkout ${DEEPEP_BRANCH} \
 && LDFLAGS="-fuse-ld=mold" MAX_JOBS="${MAX_JOBS:-$(nproc)}" python3 setup.py --variant rocm --rocm-explicit-ctx --nic ${DEEPEP_NIC} --rocm-gfx942-fp8-fnuz-max 224 bdist_wheel --dist-dir=/app/deep_install

# rdma-core recent enough for rocshmem (replaces the distro libraries in runtime).
FROM dev AS build_rdma_core
RUN git clone --branch v62.0 --depth 1 https://github.com/linux-rdma/rdma-core.git /tmp/rdma-core \
    && cd /tmp/rdma-core && mkdir build && cd build \
    && cmake -GNinja -DCMAKE_INSTALL_PREFIX=/usr -DNO_MAN_PAGES=1 .. \
    && ninja && DESTDIR=/out ninja install

# The runtime: stack + every compiled component + all pip dependencies + all env. Published as base-nightly.
FROM dev AS runtime
# NIC backend for MoRI RDMA support.
# By default (all), drivers and userspace libraries for all supported NIC types
# (ainic and bnxt) are installed; MoRI selects the appropriate one at runtime.
# To install drivers for a single NIC type only, set NIC_BACKEND explicitly:
#   --build-arg NIC_BACKEND=ainic   # AMD AINIC (Pensando) only
#   --build-arg NIC_BACKEND=bnxt    # Broadcom Thor-2 only
#   --build-arg NIC_BACKEND=none    # Install nothing.
ARG NIC_BACKEND=all
# AMD AINIC apt repo settings
# Users can specify a custom version compatible with their host drivers.
# The default version has been tested with ionic-dkms=26.03.3.001
# (libionic1=54.0-187-1), required for MoRI-EP/NIXL on Pollara/AINIC.
ARG AINIC_VERSION=1.117.5-a-77
ARG UBUNTU_CODENAME=jammy
RUN --mount=type=cache,target=/root/.cache/pip /bin/bash -lc 'set -euo pipefail; \
 \
 install_ainic() { \
   apt-get update && apt-get install -y --no-install-recommends ca-certificates curl gnupg apt-transport-https; \
   rm -rf /var/lib/apt/lists/*; \
   mkdir -p /etc/apt/keyrings; \
   curl -fsSL https://repo.radeon.com/rocm/rocm.gpg.key | gpg --dearmor > /etc/apt/keyrings/amdainic.gpg; \
   echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/amdainic.gpg] https://repo.radeon.com/amdainic/pensando/ubuntu/${AINIC_VERSION} ${UBUNTU_CODENAME} main" \
     > /etc/apt/sources.list.d/amdainic.list; \
   apt-get update && apt-get install -y --no-install-recommends \
     libionic-dev \
     ionic-common \
   ; \
   rm -rf /var/lib/apt/lists/*; \
 }; \
 \
 # NOTE: requires FW 235.2.86.0 and kernel drivers on the host: \
 #   bnxt-en-dkms=1.10.3.235.2.86.0 bnxt-re-dkms=235.2.86.0 (from packages.broadcom.com PPA) \
 install_bnxt() { \
   install -m 0755 -d /etc/apt/keyrings; \
   curl -fsSL https://packages.broadcom.com/artifactory/api/security/keypair/PackagesKey/public \
     -o /etc/apt/keyrings/broadcom-nic.asc; \
   chmod a+r /etc/apt/keyrings/broadcom-nic.asc; \
   echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/broadcom-nic.asc] https://packages.broadcom.com/artifactory/ethernet-nic-debian-public jammy main" \
     > /etc/apt/sources.list.d/broadcom-nic.list; \
   apt-get update && apt-get install -y --no-install-recommends \
     bnxt-rocelib=235.2.86.0 \
   ; \
   cp -a /usr/local/lib/x86_64-linux-gnu/libbnxt_re* /usr/local/lib/; \
   ldconfig; \
   rm -rf /var/lib/apt/lists/*; \
 }; \
 \
 pip install --quiet --ignore-installed blinker; \
 echo "[MORI] NIC_BACKEND=${NIC_BACKEND}"; \
 \
 # NIC backend deps — mori auto-detects NIC at runtime (MORI_DEVICE_NIC env var override). \
 # Only vendor packages are installed here for dlopen; no compile-time flags needed. \
 case "${NIC_BACKEND}" in \
   none)  ;; \
   all)   install_ainic; install_bnxt ;; \
   ainic) install_ainic ;; \
   bnxt)  install_bnxt ;; \
   *)     echo "ERROR: unknown NIC_BACKEND=${NIC_BACKEND}. Use one of: none, ainic, bnxt, all"; exit 2 ;; \
 esac'
RUN echo "MORI_NIC_BACKEND=${NIC_BACKEND}" >> /app/versions.txt \
    && echo "AINIC_VERSION=${AINIC_VERSION}" >> /app/versions.txt

COPY --from=build_rdma_core /out /
# Install torchcodec from source for ROCm/torch ABI compatibility.
RUN --mount=type=bind,source=tools/install_torchcodec_rocm.sh,target=/tmp/install_torchcodec.sh \
    --mount=type=cache,target=/root/.cache/uv \
    --mount=type=cache,target=/root/.cache/pip \
    --mount=type=tmpfs,target=/root/.cache/torchcodec-wheels \
    ldconfig && bash /tmp/install_torchcodec.sh
# All Python dependencies, at the versions CI tests (the test lock is a constraint).
# quart, msgpack, aiohttp, pyzmq: MoRI proxy dependencies.
RUN --mount=type=bind,source=requirements/common.txt,target=/r/common.txt \
    --mount=type=bind,source=requirements/rocm.txt,target=/r/rocm.txt \
    --mount=type=bind,source=requirements/test/rocm.txt,target=/r/test.txt \
    --mount=type=bind,from=build_nixl,src=/app/install,target=/nixl \
    --mount=type=bind,from=build_deepep,src=/app/deep_install,target=/deepep \
    --mount=type=bind,from=build_lmcache,src=/app/install,target=/lmcache \
    --mount=type=cache,id=vllm-rocm-uv,target=/root/.cache/uv \
    uv pip install --system -c /etc/rocm-constraints.txt -c /r/test.txt -r /r/rocm.txt \
        /nixl/*.whl /deepep/*.whl /lmcache/*.whl quart msgpack aiohttp pyzmq \
    && python3 -c "import lmcache, lmcache.c_ops; print('lmcache', lmcache.__version__)"
# Rebuild fastsafetensors from source so its C++ extension is compiled with
# USE_ROCM and can detect libamdhip64.so at runtime.
RUN --mount=type=bind,source=requirements/test/rocm.txt,target=/r/test.txt \
    --mount=type=cache,target=/root/.cache/pip \
    FASTSAFETENSORS_REQ="$(grep -E '^fastsafetensors(==| @ )' /r/test.txt | head -1)" \
    && test -n "${FASTSAFETENSORS_REQ}" \
    && python3 -m pip install --force-reinstall --no-deps \
        --no-binary fastsafetensors "${FASTSAFETENSORS_REQ}"

# ROCm profiler limits workaround.
RUN echo "ROCTRACER_MAX_EVENTS=10000000" > /app/libkineto.conf
ENV KINETO_CONFIG="/app/libkineto.conf"
# Set MIOPEN ENVS to resolve performance regressions in MIOpen 3D convolution kernel.
# See: https://github.com/pytorch/pytorch/issues/169857
ENV MIOPEN_DEBUG_CONV_DIRECT=0
ENV MIOPEN_DEBUG_CONV_GEMM=0
# Use legacy IPC mode for HSA to avoid GPU memory pinning issues with UCX rocm_ipc.
# See: https://github.com/ROCm/rocm-libraries/issues/6266
ENV HSA_ENABLE_IPC_MODE_LEGACY=1
ENV UCX_ROCM_COPY_SIGPOOL_MAX_ELEMS=inf
ENV UCX_ROCM_IPC_SIGPOOL_MAX_ELEMS=inf
ENV TOKENIZERS_PARALLELISM=false
# ENV that can improve safe tensor loading, and end-to-end time
ENV SAFETENSORS_FAST_GPU=1
# Performance environment variable.
ENV HIP_FORCE_DEV_KERNARG=1
# Keep torch.cuda.is_available() fork-safe (see vllm/env_override.py).
ENV PYTORCH_NVML_BASED_CUDA_CHECK=1
ARG STACK
LABEL ai.vllm.rocm.stack=${STACK}

FROM dev AS rust-toolchain
ENV CARGO_HOME=/root/.cargo
ENV RUSTUP_HOME=/root/.rustup
ENV PATH=${CARGO_HOME}/bin:${PATH}
RUN --mount=type=bind,source=rust-toolchain.toml,target=/tmp/rust-toolchain.toml \
    TOOLCHAIN="$(grep '^channel' /tmp/rust-toolchain.toml | sed 's/.*= *"\(.*\)"/\1/')" \
    && curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain none \
    && rustup toolchain install "${TOOLCHAIN}" \
    && rustup default "${TOOLCHAIN}" \
    && rustc --version \
    && cargo --version

# Test-only dependencies, a content-keyed image like the runtime (build.sh: test-deps-<stack>-<Kr>),
# so every build of a key reuses these layers by digest instead of rebuilding them from cache.
FROM runtime AS test-deps
COPY --from=rust-toolchain /root/.cargo /root/.cargo
COPY --from=rust-toolchain /root/.rustup /root/.rustup
ENV CARGO_HOME=/root/.cargo RUSTUP_HOME=/root/.rustup PATH=/root/.cargo/bin:$PATH
RUN --mount=type=bind,source=requirements/test/rocm.txt,target=/t.txt --mount=type=bind,source=tests/vllm_test_utils,target=/tu,rw \
    --mount=type=cache,id=vllm-rocm-uv,target=/root/.cache/uv \
    sp="$(python3 -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')" \
    && pip freeze --path "$sp" | sort >/tmp/shipped && uv pip install --system -c /etc/rocm-constraints.txt -r /t.txt /tu \
    && ! pip freeze --path "$sp" | sort | comm -23 /tmp/shipped - | grep . # a test dep changed a shipped package (apt's python3-* may be shadowed)
# No VLLM_GPU_SYNC_CHECK yet: AMD CI never ran with it, and ROCm code paths still sync
# (EPLB, sparse MLA, indexers, moondream3). Enable it once those are fixed.
ENV HF_XET_HIGH_PERFORMANCE=1

# ==== per-commit stages: nothing below is part of the runtime key ====

FROM dev AS triton-kernels
ARG ROCM_TRITON_KERNELS_COMMIT
ADD https://codeload.github.com/ROCm/triton/tar.gz/${ROCM_TRITON_KERNELS_COMMIT} \
    /tmp/rocm-triton.tar.gz
RUN mkdir -p /opt/rocm-triton-kernels \
    && tar --extract --gzip --file /tmp/rocm-triton.tar.gz \
        --directory /opt/rocm-triton-kernels --strip-components=4 \
        --no-same-owner \
        "triton-${ROCM_TRITON_KERNELS_COMMIT}/python/triton_kernels/triton_kernels" \
    && test -f /opt/rocm-triton-kernels/__init__.py \
    && rm /tmp/rocm-triton.tar.gz

# The version every per-commit artifact carries. build.sh writes .git_archival.txt from the host's
# `git describe` (CI checkouts keep their objects in a mirror outside the build context, which git
# here would refetch from GitHub); without it, e.g. locally, .git and a v* tag are used.
FROM dev AS version-calc
RUN --mount=type=bind,target=/src,rw cd /src \
    && if [ -f .git_archival.txt ]; then mv .git /tmp/unused-git; \
       else git config --global --add safe.directory '*'; fi \
    && python3 -c "from setuptools_scm import get_version; print(get_version(git_describe_command=['git', 'describe', '--dirty', '--tags', '--long', '--abbrev=40', '--match', 'v[0-9]*']))" \
        > /vllm-version.txt \
    && cat /vllm-version.txt && ! grep -q '^0\.1\.dev' /vllm-version.txt
FROM scratch AS version
COPY --from=version-calc /vllm-version.txt /

# Compiles the `vllm-rs` frontend once per change to the rust sources, so the wheel build does not
# need the rust toolchain. The crates, their downloads and target/ stay in this stage's layers (no
# cache mounts), so rust-build always continues from the target/ of these exact sources.
FROM rust-toolchain AS rust-deps
# Cap cargo parallelism to avoid exhausting the AMD CI host's open-file limit
# (rustc spawns enough concurrent processes to hit RLIMIT_NOFILE otherwise).
ENV CARGO_BUILD_JOBS=4
ENV CARGO_NET_RETRY=10
ENV RUSTUP_MAX_RETRIES=10
WORKDIR /app/vllm
COPY requirements/build/rust.txt requirements/build/rust.txt
RUN --mount=type=cache,id=vllm-rocm-uv,target=/root/.cache/uv \
    uv pip install --system -r requirements/build/rust.txt
COPY rust/Cargo.lock rust/Cargo.toml rust/
COPY rust/proto rust/proto
COPY rust/src rust/src
COPY rust-toolchain.toml rust-toolchain.toml
COPY tools/build_rust.py tools/build_rust.sh tools/
RUN SETUPTOOLS_SCM_PRETEND_VERSION=0.0.0 bash tools/build_rust.sh

# Per commit: vllm-rs embeds the vLLM version, so cargo recompiles only the crates that read it and
# relinks (~30 s). Those few rustc processes stay far from the open-file limit, and the job count
# also caps the thin-LTO threads, so lift the cap.
FROM rust-deps AS rust-build
COPY --from=version /vllm-version.txt /tmp/vllm-version.txt
RUN CARGO_BUILD_JOBS="$(nproc)" SETUPTOOLS_SCM_PRETEND_VERSION="$(cat /tmp/vllm-version.txt)" \
    bash tools/build_rust.sh \
    && test -x vllm/vllm-rs

# Native extensions only: copies just the files that affect the HIP/C++ build.
FROM dev AS csrc
ARG ROCM_TRITON_KERNELS_COMMIT
COPY --from=triton-kernels /opt/rocm-triton-kernels /opt/rocm-triton-kernels
ENV TRITON_KERNELS_SRC_DIR=/opt/rocm-triton-kernels
WORKDIR /app/vllm
COPY setup.py CMakeLists.txt pyproject.toml ./
COPY tools/build_rust.py tools/build_rust.py
COPY cmake cmake/
COPY csrc csrc/
COPY vllm/envs.py vllm/__init__.py vllm/
# Empty: the stack's full PYTORCH_ROCM_ARCH (release); CI passes the arches it can test.
ARG ARCH
# setup.py reads requirements/rocm.txt for install_requires. This wheel only carries the .so files
# the wheel stage repackages with the real requirements, so empty files keep a requirements bump
# from recompiling HIP.
RUN --mount=type=cache,id=vllm-rocm-ccache,target=/root/.cache/ccache \
    mkdir -p requirements && : > requirements/rocm.txt \
    && { grep -Fq "set(TRITON_KERNELS_TAG \"${ROCM_TRITON_KERNELS_COMMIT}\")" \
        cmake/external_projects/triton_kernels.cmake \
        || echo "WARNING: Dockerfile.rocm ROCM_TRITON_KERNELS_COMMIT (${ROCM_TRITON_KERNELS_COMMIT}) does not match cmake TRITON_KERNELS_TAG; the Docker build uses the Dockerfile pin, cmake governs only non-Docker builds"; } \
    && CCACHE_BASEDIR="$PWD" PYTORCH_ROCM_ARCH="${ARCH:-$PYTORCH_ROCM_ARCH}" \
       SETUPTOOLS_SCM_PRETEND_VERSION=0.0.0+rocm.csrc.build PYTHONDONTWRITEBYTECODE=1 \
       LDFLAGS="-fuse-ld=mold" MAX_JOBS="${MAX_JOBS:-$(nproc)}" python3 setup.py bdist_wheel --dist-dir=/dist \
    && rm -rf build

# The full vLLM wheel, repackaged around the csrc extensions and the rust artifacts.
FROM dev AS wheel
COPY --from=csrc /dist /precompiled
COPY --from=rust-build /app/vllm/vllm/vllm-rs /app/vllm/vllm/_rust_*.so /rust/
COPY --from=version /vllm-version.txt /
# The published wheel pins the exact stack builds (torch, triton, ...) it was compiled against.
RUN --mount=type=bind,target=/src,rw cd /src && cp /rust/* vllm/ \
    && ! grep -n 'git+' requirements/common.txt requirements/rocm.txt \
    && pip list --format=freeze \
        | grep -iE '^(torch|triton|torchvision|torchaudio|amdsmi|flash[-_]attn|amd[-_]aiter)==' >> requirements/rocm.txt \
    && SETUPTOOLS_SCM_PRETEND_VERSION="$(cat /vllm-version.txt)" VLLM_USE_PRECOMPILED=1 \
       VLLM_PRECOMPILED_WHEEL_LOCATION="$(ls /precompiled/*.whl)" VLLM_DOCKER_BUILD_CONTEXT=1 \
       PYTHONDONTWRITEBYTECODE=1 python3 setup.py bdist_wheel --dist-dir=/dist

# The installed csrc extensions (~700 MB), as their own layer: it depends only on the csrc stage,
# so a commit that leaves csrc alone reuses the layer and pulls only the Python one below.
FROM dev AS native
RUN --mount=type=bind,from=csrc,src=/dist,target=/csrc \
    sp="$(python3 -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')" \
    && mkdir -p "/out$sp" && unzip -q /csrc/*.whl 'vllm/*.so' -d "/out$sp"

# Bytecode compiled as if installed at / (not /out), so tracebacks name the real paths.
# The csrc extensions come from the native layer instead.
FROM runtime AS install
RUN --mount=type=bind,from=wheel,src=/dist,target=/dist \
    --mount=type=bind,from=csrc,src=/dist,target=/csrc \
    pip install --no-deps --no-compile --root /out /dist/*.whl \
    && sp="$(python3 -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')" \
    && unzip -Z1 /csrc/*.whl 'vllm/*.so' | sed "s|^|/out$sp/|" | xargs rm \
    && python3 -m compileall -q -j 0 -s /out -p / /out

FROM runtime AS vllm-openai
COPY --link --from=native /out /
COPY --link --from=install /out /
COPY --link benchmarks /app/vllm/benchmarks
COPY --link examples /app/vllm/examples
LABEL ai.vllm.rocm.tested-arch="gfx90a;gfx942;gfx950"
ARG VLLM_VERSION
LABEL org.opencontainers.image.version=${VLLM_VERSION}
ENTRYPOINT ["vllm", "serve"]

# Release check (cacheonly): vLLM imports offline and _C carries every arch of PYTORCH_ROCM_ARCH.
FROM vllm-openai AS openai-smoke
RUN --network=none so="$(python3 -c 'import os, vllm, vllm._C; print(os.path.dirname(vllm.__file__))')/_C.abi3.so" \
    && for a in $(echo "$PYTORCH_ROCM_ARCH" | tr ';' ' '); do \
         llvm-objdump --offloading "$so" | grep -qw "$a" || { echo "_C lacks $a" >&2; exit 1; }; done

FROM test-deps AS test-base
# AITER nightly: replace the stack's aiter with the newest nightly wheel that fits this image's ROCm,
# torch and Python (never cached, see the bake file). AITER_SPEC pins a pip spec instead.
ARG AITER_NIGHTLY
ARG AITER_SPEC
RUN --mount=type=bind,source=.buildkite/scripts/rocm/select_aiter_nightly_wheel.py,target=/tmp/select.py \
    set -e; spec="$AITER_SPEC"; \
    if [ -z "$spec" ] && [ "$AITER_NIGHTLY" = 1 ]; then \
        out="$(python3 -P /tmp/select.py)" || { echo "$out" >&2; exit 1; }; \
        echo "$out"; spec="$(echo "$out" | head -n 1)"; \
    fi; \
    if [ -n "$spec" ]; then pip install --pre --no-deps --force-reinstall "$spec" && python3 -c 'import aiter'; fi; \
    # A wheel built against a newer glibc or libstdc++ than this image installs and imports fine
    # but fails every test that loads its modules; fail here instead.
    if [ -n "$spec" ]; then \
        aiter="$(python3 -c 'import importlib.util as u; print(u.find_spec("aiter").origin)')"; \
        ! find "${aiter%/*}" -name '*.so' -exec ldd {} + 2>&1 | grep "version .* not found"; \
    fi

FROM test-base AS test
COPY --link --from=native /out /
COPY --link --from=install /out /
COPY --link --exclude=vllm --exclude=.git . /vllm-workspace/
# Source under src/ so it does not shadow the installed package in tests.
COPY --link vllm /vllm-workspace/src/vllm
WORKDIR /vllm-workspace

FROM test AS test-smoke
RUN --network=none python3 -c "import vllm, vllm._C, vllm._rocm_C; print(vllm.__version__)"

FROM scratch AS wheels
COPY --link --from=stack-wheels / /
COPY --link --from=wheel /dist/ /

# CI: the vLLM wheel alone (a build artifact for the python-only install test), and the expensive
# compile stages, whose cache PR builds export.
FROM scratch AS vllm-wheel
COPY --link --from=wheel /dist/ /
FROM scratch AS compile
COPY --link --from=csrc /dist /csrc
COPY --link --from=rust-deps /app/vllm/rust/Cargo.lock /rust/
