# 单元测试依赖镜像: 预装全部测试依赖, 供 CI 的 unit-test job 作为运行环境。
#
# 设计: 依赖(变化慢)烘在镜像里, vLLM 源码(变化快)在 CI job 里现装,
# 这样每次 CI 只需要 `pip install -e . --no-deps` + pytest, 秒级完成。
#
# 只在 requirements/*.txt 变化时需要重建:
#   docker build -f docker/Dockerfile.test-deps \
#     -t registry-cn-beijing.siflow.cn/skyinfer/vllm:unittest-latest .
#   docker push registry-cn-beijing.siflow.cn/skyinfer/vllm:unittest-latest

FROM python:3.12

ENV DEBIAN_FRONTEND=noninteractive

# apt 换国内源 (debian 官方源在集群内只有 ~20KB/s)
RUN sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources

# 音视频/图像类测试依赖的系统库 (librosa/soundfile/decord/opencv 需要)
RUN apt-get update -y \
    && apt-get install -y --no-install-recommends \
        ffmpeg \
        libsm6 \
        libxext6 \
        libgl1 \
        libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

# uv 比 pip 快得多, 350 个包的安装差距明显
RUN pip install --no-cache-dir uv
ENV UV_HTTP_TIMEOUT=500
ENV UV_INDEX_STRATEGY="unsafe-best-match"

# 完整测试依赖 (test.in 钉 torch==2.10.0+cu129, 需要 pytorch 的 cu129 index)。
#
# 为什么不直接 `-r common.txt -r test.txt`:
#   common.txt 是松约束(含 CVE-2026-0994 的 protobuf 排除 6.33.0-6.33.4、以及
#   opentelemetry 运行时依赖), test.txt 是早先由 test.in 编译出的锁文件
#   (钉 protobuf==6.33.2、opentelemetry 1.35)。两者生成时间不同、已经漂移,
#   同时安装必然版本冲突(先是 protobuf, 修掉后又是 opentelemetry-proto ...)。
#   上游从不"从零同时解析二者", 而是把 test.txt 装在已解析好 common 的 vllm
#   基础镜像之上; 本镜像是纯净 python:3.12, 没有那层基础环境。
#
# 做法: 把 common.txt + test.in 一起重新编译成一份自洽的锁, 让解析器自己挑出
#   同时满足两边约束的版本(实测得到 protobuf 6.33.6、opentelemetry 1.43,
#   torch/transformers/grpcio-tools 等硬钉版全部保留), 再安装该锁。
#   好处: requirements 变化时无需手工对齐版本, 重建即自洽。
ARG PYTORCH_CUDA_INDEX_BASE_URL=https://download.pytorch.org/whl
COPY requirements/ /tmp/requirements/
RUN uv pip compile \
        /tmp/requirements/common.txt \
        /tmp/requirements/test.in \
        --index-strategy unsafe-best-match \
        --extra-index-url ${PYTORCH_CUDA_INDEX_BASE_URL}/cu129 \
        --python-version 3.12 \
        -o /tmp/requirements/unittest.lock \
    && uv pip install --system --no-cache \
        -r /tmp/requirements/unittest.lock \
        --index-strategy unsafe-best-match \
        --extra-index-url ${PYTORCH_CUDA_INDEX_BASE_URL}/cu129 \
    && rm -rf /tmp/requirements

# 测试辅助工具包 (tests/vllm_test_utils, 内容极少但 conftest 需要)
# 源码在 CI job 里才有, 这里只装 pytest 相关的散装依赖兜底
RUN uv pip install --system --no-cache pytest pytest-asyncio pytest-forked tblib

WORKDIR /workspace
