# vLLM 快速更新镜像: 在最新 base 镜像 (docker/Dockerfile.base 构建) 之上,
# 只更新 vLLM 的 Python 源码, 完全跳过 CUDA 编译。
#
# 原理: base 里 vLLM 是编辑模式安装 (pip install -e .), site-packages 里的
# __editable__.vllm-*.pth 直接指向 /vllm-workspace/vllm 源码树, entry point
# (/usr/local/bin/vllm) 和 dist-info 也都装好了。日常发版只覆盖 .py 文件,
# Python 下次 import 就拿到新代码, 无需 rerun `pip install -e .`。
#
# 不 rerun 的好处: 不触发 setup.py -> build_ext -> cmake/ninja, 避免 ninja
# 按 mtime 判定源文件比 base 里的 .o/.so 都新 -> 认为整棵产物都过期 ->
# 数小时的全量重编 (曾经 [175/397] @ 2h 超时).
#
# 前提约束 (变了必须重建 base, 不能走 update):
#   - csrc/**  或  CMakeLists.txt / build.txt
#   - pyproject.toml 的 entry points / dependencies / dynamic metadata
#   - setup.py 或 requirements/cuda.txt / common.txt (影响装机版本对齐)
# 如果只是 vllm/**/*.py 修改, 走 update 即可。
#
# Usage:
#   docker build -f docker/Dockerfile.update \
#     --build-arg BASE_IMAGE=registry-cn-beijing.siflow.cn/skyinfer/vllm:base-latest \
#     --build-arg VLLM_BUILD_VERSION=0.1.0 \
#     -t registry-cn-beijing.siflow.cn/skyinfer/vllm:release-develop-<sha9>-<date> .

ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive
ENV UV_HTTP_TIMEOUT=500
ENV UV_INDEX_STRATEGY="unsafe-best-match"
ENV UV_BREAK_SYSTEM_PACKAGES=1

# 构建上下文可能没有完整 .git, 显式指定版本号 (PEP 440); base 已装好 dist-info,
# 这里不再重装 vllm, 版本号只用于可能的运行时/日志读取
ARG VLLM_BUILD_VERSION=0.0.0.dev0
ENV SETUPTOOLS_SCM_PRETEND_VERSION=${VLLM_BUILD_VERSION}

WORKDIR /vllm-workspace/vllm

# 覆盖 Python 源码; .dockerignore 排除 build/ 和 vllm/*.so, 所以 base 里的
# 编译产物完好保留
COPY . .

# 在 base 已有的 "base(<commit>)" 后追加 "-release(<commit>)", 最终版本形如
#   base(5af21d57c)-release(149758942)
# --append: 读当前已安装版本再拼接; base 不重装 vllm, 这里直接改写 dist-info 与
# vllm/_version.py (不重编译)。值由 .gitlab-ci.yml 注入 (-release(${SHORT_SHA}))。
ARG VLLM_VERSION_STAMP=
RUN if [ -n "${VLLM_VERSION_STAMP}" ]; then python docker/stamp_vllm_version.py "${VLLM_VERSION_STAMP}" --append; \
    else echo "VLLM_VERSION_STAMP 未设置, 保持 base 里的版本"; fi

# 内部私有仓库克隆用的 token; transformers 与 lmcache 共用 (装完各自 scrub 掉 remote)
ARG GITLAB_TOKEN=

# lmcache: 从内部 gitlab 仓库以可编辑形式安装 (源码在 /vllm-workspace/lmcache)。
# 放在 update 层: lmcache 迭代频繁, 每次发版按需切 ref, 不必重建 base。
# 仓库地址/分支/commit 全部由 CI/CD Variables 经 --build-arg 注入, 不设默认值:
#   LMCACHE_REPO_URL              必填, 留空报错
#   LMCACHE_BRANCH/LMCACHE_COMMIT 至少配一个, 都空报错
#   两个都配: 校验 commit 必须在 branch 上, 通过后以 commit 为准 (打印提示)
# 装完把 token 从 git remote 抹掉, 不把凭据留在镜像的 .git/config 里。
#
# 依赖策略: 带依赖安装 (不加 --no-deps), 让 lmcache 自己声明的依赖装齐
# (blake3/awscrt/cufile-python/numba/otel/redis/cupy...), 只对 transformers 与
# huggingface_hub 用 --overrides 压回内部分支能用的区间。不压则镜像 import
# transformers 直接失败:
#   lmcache develop_v0.5.2 的 requirements/common.txt 声明 transformers>=5.4 与
#   huggingface_hub>=1.5.0; 而内部 pretrain/transformers@feat_baseline 是 4.57.1,
#   它的 dependency_versions_check 在 import 时硬校验 huggingface-hub>=0.34.0,<1.0,
#   碰上 hub 1.x 抛 ImportError (已实测); vllm 本身也要求 transformers>=4.56.0,<5。
#   后装内部 editable 只换得掉 transformers 本体, 换不掉已被拉高的 hub -> 必须在这里挡。
# torch 在 lmcache 里不带版本约束, 已装的 2.10.0 即满足, uv 不会动它 (已实测)。
# 内部 transformers 仍排在本步骤之后, 确保 editable 最终胜出。
#
# 版本号: lmcache 用 setuptools-scm 取版本, 会读到上面为 vllm 设的全局
# ENV SETUPTOOLS_SCM_PRETEND_VERSION, 装出 lmcache==0.0.0.dev0+<vllm sha>
# (溯源时误导)。这里按命令级覆盖为 lmcache 自己 checkout 的 sha。
ARG LMCACHE_REPO_URL
ARG LMCACHE_BRANCH
ARG LMCACHE_COMMIT
RUN set -e; \
    : "${LMCACHE_REPO_URL:?LMCACHE_REPO_URL is required (set in GitLab CI/CD Variables)}"; \
    lm_branch="${LMCACHE_BRANCH:-}"; lm_commit="${LMCACHE_COMMIT:-}"; \
    if [ -z "$lm_branch" ] && [ -z "$lm_commit" ]; then \
        echo "error: LMCACHE_BRANCH 和 LMCACHE_COMMIT 至少配置一个 (set in GitLab CI/CD Variables)" >&2; exit 1; \
    fi; \
    if [ -n "${GITLAB_TOKEN:-}" ]; then \
        lm_clone_url="https://oauth2:${GITLAB_TOKEN}@${LMCACHE_REPO_URL#https://}"; \
    else \
        lm_clone_url="$LMCACHE_REPO_URL"; \
    fi; \
    git clone "$lm_clone_url" /vllm-workspace/lmcache; \
    unset lm_clone_url; \
    cd /vllm-workspace/lmcache; \
    if [ -n "$lm_commit" ] && [ -n "$lm_branch" ]; then \
        git merge-base --is-ancestor "$lm_commit" "origin/$lm_branch" \
            || { echo "error: commit $lm_commit 不在分支 $lm_branch 上" >&2; exit 1; }; \
        echo "提示: branch=$lm_branch 与 commit=$lm_commit 同时配置, 已校验 commit 在该分支上, 以 commit 为准"; \
        lm_ref="$lm_commit"; \
    elif [ -n "$lm_commit" ]; then \
        lm_ref="$lm_commit"; \
    else \
        lm_ref="$lm_branch"; \
    fi; \
    git checkout "$lm_ref"; \
    git remote set-url origin "$LMCACHE_REPO_URL"; \
    echo "lmcache checked out to ${lm_ref}"; \
    lm_sha=$(git rev-parse --short=9 HEAD); \
    echo "lmcache version stamp: 0.0.0.dev0+${lm_sha}"; \
    printf '%s\n' 'transformers>=4.56.0,<5' 'huggingface_hub>=0.34.0,<1.0' > /tmp/lmcache-overrides.txt; \
    SETUPTOOLS_SCM_PRETEND_VERSION="0.0.0.dev0+${lm_sha}" \
        uv pip install --system --no-build-isolation -e . --overrides /tmp/lmcache-overrides.txt; \
    rm -f /tmp/lmcache-overrides.txt; \
    python -c "import torch, vllm; \
assert torch.__version__.startswith('2.10.'), 'lmcache 依赖改了 torch -> '+torch.__version__; \
assert '/vllm-workspace/' in vllm.__file__, 'vllm 不再是 editable(被 lmcache 依赖覆盖) -> '+vllm.__file__; \
print('env intact after lmcache: torch', torch.__version__, '| vllm', vllm.__file__)"

# 内部 pretrain/transformers 分支 (可编辑 --no-deps 安装, 源码在 /vllm-workspace/transformers)。
# 与 lmcache 一样放在 update 层: 内部分支迭代频繁, 每次发版更新, 不必重建 base。
# ⚠️ 必须排在 lmcache 之后: lmcache 带依赖安装可能拉进 PyPI 版 transformers,
#    后装的内部 editable 才能覆盖掉它。
# REPO_URL/BRANCH 必填 (无默认值, 空则报错); COMMIT 可选 (空则停在分支 HEAD)。
# --no-deps 确保绝不触碰 vLLM 已对齐的底层依赖环境。
# 版本号: transformers 由自己 setup.py 静态声明 (不用 setuptools-scm), 但仍防御性
# 隔离为 vllm 设的全局 ENV SETUPTOOLS_SCM_PRETEND_VERSION —— 若日后内部分支改用
# setuptools-scm, 版本会取 transformers 自己的 git, 而不是静默继承 vllm 的版本串。
ARG TRANSFORMER_REPO_URL
ARG TRANSFORMER_BRANCH
ARG TRANSFORMER_COMMIT=
RUN set -e; \
    : "${TRANSFORMER_REPO_URL:?TRANSFORMER_REPO_URL is required (set in GitLab CI/CD Variables)}"; \
    : "${TRANSFORMER_BRANCH:?TRANSFORMER_BRANCH is required (set in GitLab CI/CD Variables)}"; \
    if [ -n "${GITLAB_TOKEN:-}" ]; then \
        tf_clone_url="https://oauth2:${GITLAB_TOKEN}@${TRANSFORMER_REPO_URL#https://}"; \
    else \
        tf_clone_url="$TRANSFORMER_REPO_URL"; \
    fi; \
    git clone "$tf_clone_url" /vllm-workspace/transformers; \
    unset tf_clone_url; \
    cd /vllm-workspace/transformers; \
    git checkout "$TRANSFORMER_BRANCH"; \
    if [ -n "${TRANSFORMER_COMMIT:-}" ]; then git checkout "$TRANSFORMER_COMMIT"; fi; \
    git remote set-url origin "$TRANSFORMER_REPO_URL"; \
    echo "transformers checked out to $(git rev-parse --short=9 HEAD)"; \
    env -u SETUPTOOLS_SCM_PRETEND_VERSION \
        uv pip install --system --no-build-isolation --no-deps -e .; \
    python -c "import torch, vllm, huggingface_hub as hh, transformers as tf; \
assert torch.__version__.startswith('2.10.'), 'torch 版本被改动 -> '+torch.__version__; \
assert '/vllm-workspace/' in vllm.__file__, 'vllm 不再是 editable -> '+vllm.__file__; \
assert '/vllm-workspace/' in tf.__file__, 'transformers 不是内部 editable -> '+tf.__file__; \
assert int(hh.__version__.split('.')[0]) < 1, '内部 transformers 4.x 要求 huggingface_hub<1.0 -> '+hh.__version__; \
print('env intact: torch', torch.__version__, '| vllm', vllm.__file__, '| transformers', tf.__version__, tf.__file__, '| hub', hh.__version__)"

# flashinfer-python (可编辑 --no-deps 安装, 源码在 /vllm-workspace/flashinfer)。
# 与 transformers 一样放在 update 层: 内部分支迭代频繁, 每次发版更新, 不必重建 base。
# REPO_URL/BRANCH 必填 (无默认值, 空则报错); COMMIT 可选 (空则停在分支 HEAD)。
# --no-deps 确保绝不触碰 vLLM 已对齐的底层依赖环境。
ARG FLASHINFER_REPO_URL
ARG FLASHINFER_BRANCH
ARG FLASHINFER_COMMIT=
RUN set -e; \
    : "${FLASHINFER_REPO_URL:?FLASHINFER_REPO_URL is required (set in GitLab CI/CD Variables)}"; \
    : "${FLASHINFER_BRANCH:?FLASHINFER_BRANCH is required (set in GitLab CI/CD Variables)}"; \
    if [ -n "${GITLAB_TOKEN:-}" ]; then \
        fi_clone_url="https://oauth2:${GITLAB_TOKEN}@${FLASHINFER_REPO_URL#https://}"; \
    else \
        fi_clone_url="$FLASHINFER_REPO_URL"; \
    fi; \
    git clone "$fi_clone_url" /vllm-workspace/flashinfer; \
    unset fi_clone_url; \
    cd /vllm-workspace/flashinfer && git submodule update --init --recursive; \
    git checkout "$FLASHINFER_BRANCH"; \
    if [ -n "${FLASHINFER_COMMIT:-}" ]; then git checkout "$FLASHINFER_COMMIT"; fi; \
    git remote set-url origin "$FLASHINFER_REPO_URL"; \
    uv pip install --system --no-build-isolation --no-deps -e .

ENTRYPOINT ["vllm", "serve"]
