# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
#
# Multi-stage BYOG image:
#   Stage 1 (`byog-tools`): isolated Python 3.12.9 runtime + BYOG CLI/plugins.
#   Stage 2 (`byog`): layers /opt/byog onto an explicit VLLM_BASE_IMAGE.
#
# Example:
#   docker build -f docker/Dockerfile.byog \
#       --build-arg VLLM_BASE_IMAGE=public.ecr.aws/.../vllm-ci@sha256:... \
#       --build-arg VLLM_COMMIT=<git-sha> -t byog:dev .

ARG PYTHON_IMAGE=python:3.12.9-slim
ARG PYTHON_VERSION=3.12.9
ARG UV_VERSION=0.6.14
ARG VLLM_BASE_IMAGE=vllm-base-image-must-be-set-via-build-arg
ARG VLLM_COMMIT=""

FROM ${PYTHON_IMAGE} AS byog-tools

ARG PYTHON_VERSION
ARG UV_VERSION

ENV UV_PYTHON_INSTALL_DIR=/opt/byog/python \
    UV_PYTHON_PREFERENCE=only-managed \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN pip install --no-cache-dir "uv==${UV_VERSION}"

WORKDIR /opt/byog
COPY tools/byog/requirements.lock /opt/byog/requirements.lock
RUN uv python install "${PYTHON_VERSION}" && \
    uv venv /opt/byog/venv --python "${PYTHON_VERSION}" && \
    uv pip install --python /opt/byog/venv/bin/python --no-cache -r /opt/byog/requirements.lock

COPY tools/byog /opt/byog/src/tools/byog

RUN mkdir -p /opt/byog/bin && \
    printf '%s\n' \
      '#!/usr/bin/env bash' \
      'set -euo pipefail' \
      'export PYTHONPATH="/opt/byog/src"' \
      'exec /opt/byog/venv/bin/python -P -m tools.byog "$@"' \
      > /opt/byog/bin/byog && \
    chmod +x /opt/byog/bin/byog

FROM ${VLLM_BASE_IMAGE} AS byog

ARG VLLM_BASE_IMAGE
ARG VLLM_COMMIT

ENV BYOG_IMAGE="${VLLM_BASE_IMAGE}" \
    BYOG_VLLM_COMMIT="${VLLM_COMMIT}"

COPY --from=byog-tools /opt/byog /opt/byog
RUN ln -sf /opt/byog/bin/byog /usr/local/bin/byog

ENTRYPOINT []
CMD ["byog", "--help"]
