ARG BASE_IMAGE=rocm/dev-ubuntu-22.04:7.2.3-complete
ARG TRITON_BRANCH="f0b55c07da61c71775bef6d1a15ebf846430ac75" # release/internal/3.7.x as of 08/18
ARG TRITON_REPO="https://github.com/ROCm/triton.git"
ARG TRITON_LLVM_URL="https://oaitriton.blob.core.windows.net/public/llvm-builds/llvm-1f126a6d-ubuntu-x64-1.tar.gz"
ARG TRITON_LLVM_SHA256="0f9d80678e969a7966da672e2648cda7bb475c246d3a36ff6a4986d09916b0eb"
ARG PYTORCH_BRANCH="6bbd26020da1c6dc198625dfcdd968b1e4e6b1c5" # release/2.12 as of 08/02
ARG PYTORCH_REPO="https://github.com/ROCm/pytorch.git"
ARG PYTORCH_VISION_BRANCH="df56172e4d5a8d0cd51384273bc6c5747f5ab931" # v0.27.1
ARG PYTORCH_VISION_REPO="https://github.com/pytorch/vision.git"
ARG PYTORCH_AUDIO_BRANCH="34c52a67e8941bbd8e6adaca0eb0b9eabec11d78" # v2.11.0
ARG PYTORCH_AUDIO_REPO="https://github.com/pytorch/audio.git"
ARG FA_BRANCH="0e60e39473e8df549a20fb5353760f7a65b30e2d"
ARG FA_REPO="https://github.com/Dao-AILab/flash-attention.git"
ARG AITER_BRANCH="b70c470b21ec05cc0e101e916e35f03e45fd0e08" # v0.1.21.post1
ARG AITER_REPO="https://github.com/ROCm/aiter.git"
ARG MORI_BRANCH="c4d5877a50a20dea00b414c4422ebc240228684e" # v1.1.0
ARG MORI_REPO="https://github.com/ROCm/mori.git"
ARG ROCPROFILER_SDK_REPO="https://github.com/ROCm/rocm-systems.git"
ARG ROCPROFILER_SDK_COMMIT="2b22ab0195cc1461cd9abf3b969e9dd7c10af350"
ARG ROCM_RUNTIME_REPO="https://github.com/mawong-amd/rocm-systems.git"
ARG ROCM_RUNTIME_COMMIT="c7e40e16bca10311af72aee09cfa0cd1726f70a7"
ARG GET_PIP_URL="https://raw.githubusercontent.com/pypa/get-pip/f6f644156f23dfe9acc06e7b9ca75eee311f2e37/public/get-pip.py"
ARG GET_PIP_SHA256="fb24e693bab954209a063d90953621412ccad4a500905a726286e038f508ddf6"
ARG PIP_VERSION="26.2.1"

# Sccache configuration (only used in release pipeline)
ARG USE_SCCACHE
ARG SCCACHE_DOWNLOAD_URL
ARG SCCACHE_VERSION=v0.8.1
ARG SCCACHE_DOWNLOAD_SHA256=e0ee621fb16b6940666cd770b091c62cadafd3e062dd12e3a49d9caaff3b795f
ARG SCCACHE_ENDPOINT
ARG SCCACHE_BUCKET_NAME=vllm-build-sccache
ARG SCCACHE_REGION_NAME=us-west-2
ARG SCCACHE_S3_NO_CREDENTIALS=0


###
### ROCr + CLR build
###
# Pull in updates to ROCr + clr from ROCm 7.2.4 and beyond. Happens before base so they
# are present in each downstream stage
FROM ${BASE_IMAGE} AS build_rocm_runtime
ARG ROCM_RUNTIME_REPO
ARG ROCM_RUNTIME_COMMIT
RUN apt-get update \
    && apt-get install -y --no-install-recommends git cmake ninja-build g++ pkg-config \
       python3-pip libelf-dev libdrm-dev libnuma-dev libdw-dev xxd \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir CppHeaderParser==2.7.4 ply==3.11
RUN git init -q /src && cd /src \
    && git remote add origin ${ROCM_RUNTIME_REPO} \
    && git config core.sparseCheckout true \
    && git config remote.origin.promisor true \
    && git config remote.origin.partialclonefilter blob:none \
    && git sparse-checkout init --cone \
    && git sparse-checkout set projects/rocr-runtime projects/clr projects/hip shared cmake \
    && git fetch --filter=blob:none --depth 1 origin ${ROCM_RUNTIME_COMMIT} \
    && git checkout -q --detach FETCH_HEAD \
    && test "$(git rev-parse HEAD)" = "${ROCM_RUNTIME_COMMIT}"
# ROCr's trap_handler and blit_shaders call find_package(Clang/LLVM REQUIRED) only to get
# IMPORTED executables. The ROCm dev image ships the binaries but no CMake package config, so
# supply one pointing at them.
RUN mkdir -p /opt/rocm-cmake-shim \
    && printf 'if(NOT TARGET clang)\n  add_executable(clang IMPORTED GLOBAL)\n  set_target_properties(clang PROPERTIES IMPORTED_LOCATION "/opt/rocm/llvm/bin/clang")\nendif()\nset(Clang_PACKAGE_VERSION "rocm-image-shim")\n' > /opt/rocm-cmake-shim/ClangConfig.cmake \
    && printf 'if(NOT TARGET llvm-objcopy)\n  add_executable(llvm-objcopy IMPORTED GLOBAL)\n  set_target_properties(llvm-objcopy PROPERTIES IMPORTED_LOCATION "/opt/rocm/llvm/bin/llvm-objcopy")\nendif()\nset(LLVM_FOUND TRUE)\nset(LLVM_PACKAGE_VERSION "rocm-image-shim")\n' > /opt/rocm-cmake-shim/LLVMConfig.cmake
# ROCr first, and installed into /opt/rocm, because the clr build below needs its headers
RUN cd /src/projects/rocr-runtime \
    && cmake -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_PREFIX_PATH=/opt/rocm \
        -DCMAKE_INSTALL_PREFIX=/opt/rocm \
        -DClang_DIR=/opt/rocm-cmake-shim \
        -DLLVM_DIR=/opt/rocm-cmake-shim \
    && cmake --build build --parallel 16 \
    && cmake --install build \
    && cmake --install build --prefix /rocr-install --strip
RUN cd /src/projects/clr \
    && cmake -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCLR_BUILD_HIP=ON \
        -DCLR_BUILD_OCL=OFF \
        -DHIP_COMMON_DIR=/src/projects/hip \
        -DROCM_PATH=/opt/rocm \
        -DCMAKE_PREFIX_PATH=/opt/rocm \
        -DCMAKE_INSTALL_PREFIX=/opt/rocm \
        -DLLVM_DIR=/opt/rocm-cmake-shim \
        -DHIP_LLVM_ROOT=/opt/rocm/llvm \
    && cmake --build build --parallel 16 \
    && cmake --install build --prefix /clr-install --strip
RUN mkdir -p /staging/lib \
    && cp -P /rocr-install/lib/libhsa-runtime64.so* /staging/lib/ \
    && cp -P /clr-install/lib/libamdhip64.so* /staging/lib/ \
    && ls -l /staging/lib


FROM ${BASE_IMAGE} AS base

ENV PATH=/opt/rocm/llvm/bin:/opt/rocm/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ENV ROCM_PATH=/opt/rocm
ENV LD_LIBRARY_PATH=/opt/rocm/lib:/usr/local/lib:

COPY --from=build_rocm_runtime /staging/ /opt/rocm/
# Hard link the patched library onto every stock file name so that both the
# SONAME lookup and the hard coded paths resolve to it.
RUN set -eux; \
    cd /opt/rocm/lib; \
    ours_hsa="$(readlink -f libhsa-runtime64.so.1)"; \
    ours_hip="$(readlink -f libamdhip64.so.7)"; \
    for f in libhsa-runtime64.so.1.*; do \
        [ "$f" = "${ours_hsa##*/}" ] || ln -f "$ours_hsa" "$f"; \
    done; \
    for f in libamdhip64.so.7.*; do \
        [ "$f" = "${ours_hip##*/}" ] || ln -f "$ours_hip" "$f"; \
    done; \
    ldconfig

ARG PYTORCH_ROCM_ARCH=gfx90a;gfx942;gfx950;gfx1100;gfx1101;gfx1200;gfx1201;gfx1150;gfx1151
ENV PYTORCH_ROCM_ARCH=${PYTORCH_ROCM_ARCH}
ENV AITER_ROCM_ARCH=gfx942;gfx950
# Note: Do not set MORI_GPU_ARCHS here, it is automatically inferred at runtime

# Required for RCCL in ROCm7.1
ENV HSA_NO_SCRATCH_RECLAIM=1

ARG PYTHON_VERSION=3.12
ENV PYTHON_VERSION=${PYTHON_VERSION}
ARG GET_PIP_URL
ARG GET_PIP_SHA256
ARG PIP_VERSION

RUN mkdir -p /app
WORKDIR /app
ENV DEBIAN_FRONTEND=noninteractive

# Install Python and other dependencies (plus gcc-13, selected later in build_pytorch).
# add-apt-repository is build-only. Its distro Python bindings target the
# Ubuntu Python ABI and are unusable after python3 switches to 3.12.
RUN apt-get update -y \
    && apt-get install -y software-properties-common git curl sudo vim less libgfortran5 libopenmpi-dev libpci-dev liblzma-dev pkg-config \
    && for i in 1 2 3; do \
        add-apt-repository -y ppa:deadsnakes/ppa && add-apt-repository -y ppa:ubuntu-toolchain-r/test && break || \
        { echo "Attempt $i failed, retrying in 5s..."; sleep 5; }; \
    done \
    && apt-get update -y \
    && apt-get install -y python${PYTHON_VERSION} python${PYTHON_VERSION}-dev python${PYTHON_VERSION}-venv \
       python${PYTHON_VERSION}-lib2to3 python-is-python3 gcc-13 g++-13 \
    && apt-get purge -y software-properties-common python3-software-properties python3-gi \
    && update-alternatives --install /usr/bin/python3 python3 /usr/bin/python${PYTHON_VERSION} 1 \
    && update-alternatives --set python3 /usr/bin/python${PYTHON_VERSION} \
    && ln -sf /usr/bin/python${PYTHON_VERSION}-config /usr/bin/python3-config \
    && curl -fLsS --retry 3 --retry-delay 5 "${GET_PIP_URL}" -o /tmp/get-pip.py \
    && printf '%s  %s\n' "${GET_PIP_SHA256}" /tmp/get-pip.py | sha256sum --check - \
    && python${PYTHON_VERSION} /tmp/get-pip.py "pip==${PIP_VERSION}" \
    && rm -f /tmp/get-pip.py \
    && python3 --version && python3 -m pip --version \
    && rm -rf /var/lib/apt/lists/*

RUN --mount=type=bind,source=requirements/build/rocm-constraints.txt,target=/tmp/rocm-constraints.txt,ro \
    pip install --constraint /tmp/rocm-constraints.txt \
        packaging cmake==3.31.10 ninja wheel setuptools pybind11 Cython==3.3.0
RUN apt-get update && apt-get install -y libjpeg-dev libsox-dev libsox-fmt-all sox && rm -rf /var/lib/apt/lists/*

# Install sccache if USE_SCCACHE is enabled (for release builds)
ARG USE_SCCACHE
ARG SCCACHE_DOWNLOAD_URL
ARG SCCACHE_VERSION
ARG SCCACHE_DOWNLOAD_SHA256
ARG SCCACHE_ENDPOINT
ARG SCCACHE_BUCKET_NAME
ARG SCCACHE_REGION_NAME
ARG SCCACHE_S3_NO_CREDENTIALS
RUN if [ "$USE_SCCACHE" = "1" ]; then \
        echo "Installing sccache..." \
        && SCCACHE_ARCH="x86_64" \
        && SCCACHE_DL_URL="${SCCACHE_DOWNLOAD_URL:-https://github.com/mozilla/sccache/releases/download/${SCCACHE_VERSION}/sccache-${SCCACHE_VERSION}-${SCCACHE_ARCH}-unknown-linux-musl.tar.gz}" \
        && curl -fL --retry 3 --retry-delay 5 -o /tmp/sccache.tar.gz "${SCCACHE_DL_URL}" \
        && printf '%s  %s\n' "${SCCACHE_DOWNLOAD_SHA256}" /tmp/sccache.tar.gz | sha256sum --check - \
        && tar -xzf /tmp/sccache.tar.gz -C /tmp \
        && mv /tmp/sccache-${SCCACHE_VERSION}-${SCCACHE_ARCH}-unknown-linux-musl/sccache /usr/bin/sccache \
        && chmod +x /usr/bin/sccache \
        && rm -rf /tmp/sccache.tar.gz /tmp/sccache-${SCCACHE_VERSION}-${SCCACHE_ARCH}-unknown-linux-musl \
        && sccache --version; \
    fi

# Setup sccache for HIP compilation via HIP_CLANG_PATH
# This creates wrapper scripts in a separate directory and points HIP to use them
# This avoids modifying the original ROCm binaries which can break detection
# NOTE: HIP_CLANG_PATH is NOT set as ENV to avoid affecting downstream images (Dockerfile.rocm)
# Instead, each build stage should export HIP_CLANG_PATH=/opt/sccache-wrappers if USE_SCCACHE=1
RUN if [ "$USE_SCCACHE" = "1" ]; then \
        echo "Setting up sccache wrappers for HIP compilation..." \
        && mkdir -p /opt/sccache-wrappers \
        && printf '#!/bin/bash\nexec sccache /opt/rocm/lib/llvm/bin/clang++ "$@"\n' > /opt/sccache-wrappers/clang++ \
        && chmod +x /opt/sccache-wrappers/clang++ \
        && printf '#!/bin/bash\nexec sccache /opt/rocm/lib/llvm/bin/clang "$@"\n' > /opt/sccache-wrappers/clang \
        && chmod +x /opt/sccache-wrappers/clang \
        && echo "sccache wrappers created in /opt/sccache-wrappers"; \
    fi

# Set sccache environment variables only when USE_SCCACHE=1
# This prevents S3 config from leaking into images when sccache is not used
ARG USE_SCCACHE
ENV SCCACHE_BUCKET=${USE_SCCACHE:+${SCCACHE_BUCKET_NAME}}
ENV SCCACHE_REGION=${USE_SCCACHE:+${SCCACHE_REGION_NAME}}
ENV SCCACHE_S3_NO_CREDENTIALS=${USE_SCCACHE:+${SCCACHE_S3_NO_CREDENTIALS}}
ENV SCCACHE_IDLE_TIMEOUT=${USE_SCCACHE:+0}


###
### Triton Build
###
FROM base AS build_triton
ARG TRITON_BRANCH
ARG TRITON_REPO
ARG TRITON_LLVM_URL
ARG TRITON_LLVM_SHA256
RUN git clone ${TRITON_REPO} triton \
    && cd triton \
    && git checkout --detach ${TRITON_BRANCH} \
    && test "$(git rev-parse HEAD)" = "${TRITON_BRANCH}"
RUN curl -fLsS --retry 3 --retry-delay 5 "${TRITON_LLVM_URL}" \
        -o /tmp/triton-llvm.tar.gz \
    && printf '%s  %s\n' "${TRITON_LLVM_SHA256}" /tmp/triton-llvm.tar.gz \
        | sha256sum --check - \
    && mkdir -p /opt/triton-llvm \
    && tar -xzf /tmp/triton-llvm.tar.gz -C /opt/triton-llvm \
        --strip-components=1 \
    && rm -f /tmp/triton-llvm.tar.gz
RUN cd triton \
    && git config --global user.email "you@example.com" && git config --global user.name "Your Name" \
    && if [ ! -f setup.py ]; then cd python; fi \
    && TRITON_OFFLINE_BUILD=1 TRITON_BUILD_PROTON=OFF \
       LLVM_SYSPATH=/opt/triton-llvm \
       python3 setup.py bdist_wheel --dist-dir=dist \
    && mkdir -p /app/install && cp dist/*.whl /app/install


###
### AMD SMI Build
###
FROM base AS build_amdsmi
RUN cd /opt/rocm/share/amd_smi \
    && pip wheel --no-build-isolation --no-deps . --wheel-dir=dist
RUN mkdir -p /app/install && cp /opt/rocm/share/amd_smi/dist/*.whl /app/install


###
### Pytorch build
###
FROM base AS build_pytorch
ARG PYTORCH_BRANCH
ARG PYTORCH_REPO
ARG USE_SCCACHE

RUN apt-get update && apt-get install -y pkg-config liblzma-dev
# torch 2.12 emits float->__bf16 libcalls (__truncsfbf2) absent from gcc-11 libgcc; build with gcc-13.
RUN update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-13 130 --slave /usr/bin/g++ g++ /usr/bin/g++-13
RUN git clone ${PYTORCH_REPO} pytorch \
    && cd pytorch \
    && git checkout --detach ${PYTORCH_BRANCH} \
    && test "$(git rev-parse HEAD)" = "${PYTORCH_BRANCH}"
# The pinned PyTorch requirements fix every root. Pin their build-only
# transitive closure here because several versions intentionally differ from
# the shared ROCm build constraints.
RUN cd pytorch \
    && pip install --no-deps \
        attrs==26.1.0 certifi==2026.7.22 charset-normalizer==3.5.1 \
        click==8.3.3 idna==3.19 importlib-metadata==9.0.1 \
        markupsafe==3.0.3 mpmath==1.3.0 pyproject-hooks==1.2.0 \
        sortedcontainers==2.4.0 urllib3==2.7.0 uv==0.12.9 zipp==4.1.0 \
    && pip install --no-deps -r requirements.txt \
    && python3 -m pip check \
    && git submodule update --init --recursive
RUN cd pytorch && python3 tools/amd_build/build_amd.py \
    && if [ "$USE_SCCACHE" = "1" ]; then \
           export HIP_CLANG_PATH=/opt/sccache-wrappers \
           && export CMAKE_C_COMPILER_LAUNCHER=sccache \
           && export CMAKE_CXX_COMPILER_LAUNCHER=sccache \
           && sccache --show-stats; \
       fi \
    && CMAKE_PREFIX_PATH=$(python3 -c 'import sys; print(sys.prefix)') python3 setup.py bdist_wheel --dist-dir=dist \
    && if [ "$USE_SCCACHE" = "1" ]; then sccache --show-stats; fi
RUN mkdir -p /app/install && cp /app/pytorch/dist/*.whl /app/install


###
### Shared PyTorch runtime for dependent builds
###
FROM base AS build_pytorch_runtime
RUN update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-13 130 --slave /usr/bin/g++ g++ /usr/bin/g++-13
RUN --mount=type=bind,source=requirements/build/rocm-constraints.txt,target=/tmp/rocm-constraints.txt,ro \
    --mount=type=bind,from=build_pytorch,src=/app/install/,target=/install/pytorch,ro \
    pip install --constraint /tmp/rocm-constraints.txt \
        /install/pytorch/*.whl

# Only AITER consumes the source-built Triton wheel. Keeping it out of the
# shared PyTorch runtime lets the other native wheel builds remain parallel
# when the Triton source changes.
FROM build_pytorch_runtime AS build_pytorch_triton_runtime
RUN --mount=type=bind,source=requirements/build/rocm-constraints.txt,target=/tmp/rocm-constraints.txt,ro \
    --mount=type=bind,from=build_triton,src=/app/install/,target=/install/triton,ro \
    pip install --constraint /tmp/rocm-constraints.txt \
        /install/triton/*.whl


###
### TorchVision build
###
FROM build_pytorch_runtime AS build_torchvision
ARG PYTORCH_VISION_BRANCH
ARG PYTORCH_VISION_REPO
ARG USE_SCCACHE

RUN git clone ${PYTORCH_VISION_REPO} vision \
    && cd vision \
    && git checkout --detach ${PYTORCH_VISION_BRANCH} \
    && test "$(git rev-parse HEAD)" = "${PYTORCH_VISION_BRANCH}"
RUN cd vision \
    && if [ "$USE_SCCACHE" = "1" ]; then \
           export HIP_CLANG_PATH=/opt/sccache-wrappers \
           && export CMAKE_C_COMPILER_LAUNCHER=sccache \
           && export CMAKE_CXX_COMPILER_LAUNCHER=sccache; \
       fi \
    && python3 setup.py bdist_wheel --dist-dir=dist \
    && if [ "$USE_SCCACHE" = "1" ]; then sccache --show-stats; fi
RUN mkdir -p /app/install && cp /app/vision/dist/*.whl /app/install


###
### TorchAudio build
###
FROM build_pytorch_runtime AS build_torchaudio
ARG PYTORCH_AUDIO_BRANCH
ARG PYTORCH_AUDIO_REPO
ARG USE_SCCACHE

RUN git clone ${PYTORCH_AUDIO_REPO} audio \
    && cd audio \
    && git checkout --detach ${PYTORCH_AUDIO_BRANCH} \
    && test "$(git rev-parse HEAD)" = "${PYTORCH_AUDIO_BRANCH}" \
    && git submodule update --init --recursive
RUN --mount=type=bind,source=requirements/build/rocm-constraints.txt,target=/tmp/rocm-constraints.txt,ro \
    cd audio \
    && pip install --constraint /tmp/rocm-constraints.txt -r requirements.txt
RUN cd audio \
    && if [ "$USE_SCCACHE" = "1" ]; then \
           export HIP_CLANG_PATH=/opt/sccache-wrappers \
           && export CMAKE_C_COMPILER_LAUNCHER=sccache \
           && export CMAKE_CXX_COMPILER_LAUNCHER=sccache; \
       fi \
    && python3 setup.py bdist_wheel --dist-dir=dist \
    && if [ "$USE_SCCACHE" = "1" ]; then sccache --show-stats; fi
RUN mkdir -p /app/install && cp /app/audio/dist/*.whl /app/install


###
### MORI Build
###
FROM build_pytorch_runtime AS build_mori
ARG MORI_BRANCH
ARG MORI_REPO
RUN git clone ${MORI_REPO} mori \
    && cd mori \
    && git checkout --detach ${MORI_BRANCH} \
    && test "$(git rev-parse HEAD)" = "${MORI_BRANCH}" \
    && git submodule update --init --recursive \
    && python3 setup.py bdist_wheel --dist-dir=dist && ls /app/mori/dist/*.whl
RUN mkdir -p /app/install && cp /app/mori/dist/*.whl /app/install


###
### FlashAttention Build
###
FROM build_pytorch_runtime AS build_fa
ARG FA_BRANCH
ARG FA_REPO
ARG USE_SCCACHE
RUN --mount=type=bind,source=requirements/build/rocm-constraints.txt,target=/tmp/rocm-constraints.txt,ro \
    pip install --constraint /tmp/rocm-constraints.txt psutil \
    && git clone ${FA_REPO} flash-attention \
    && cd flash-attention \
    && git checkout --detach ${FA_BRANCH} \
    && test "$(git rev-parse HEAD)" = "${FA_BRANCH}" \
    && git submodule update --init \
    && if [ "$USE_SCCACHE" = "1" ]; then \
           export HIP_CLANG_PATH=/opt/sccache-wrappers \
           && sccache --show-stats; \
       fi \
    && FLASH_ATTENTION_FORCE_BUILD=TRUE \
       GPU_ARCHS=$(echo ${PYTORCH_ROCM_ARCH} | sed -e 's/;gfx1[0-9]\{3\}//g') \
       python3 setup.py bdist_wheel --dist-dir=dist \
    && if [ "$USE_SCCACHE" = "1" ]; then sccache --show-stats; fi
RUN mkdir -p /app/install && cp /app/flash-attention/dist/*.whl /app/install


###
### AITER Build
###
FROM build_pytorch_triton_runtime AS build_aiter
ARG AITER_BRANCH
ARG AITER_REPO
ARG USE_SCCACHE
RUN git clone --no-checkout ${AITER_REPO} aiter \
    && cd aiter \
    && git checkout --detach ${AITER_BRANCH} \
    && test "$(git rev-parse HEAD)" = "${AITER_BRANCH}" \
    && git submodule update --init --recursive
RUN --mount=type=bind,source=requirements/build/rocm-constraints.txt,target=/tmp/rocm-constraints.txt,ro \
    pip install --constraint /tmp/rocm-constraints.txt \
        pandas psutil pyyaml einops pybind11 ninja flydsl \
        setuptools-scm vcs-versioning
RUN cd aiter \
    && if [ "$USE_SCCACHE" = "1" ]; then \
           export HIP_CLANG_PATH=/opt/sccache-wrappers \
           && sccache --show-stats; \
       fi \
    && PREBUILD_KERNELS=1 AITER_USE_SYSTEM_TRITON=1 GPU_ARCHS=${AITER_ROCM_ARCH} python3 setup.py bdist_wheel --dist-dir=dist \
    && if [ "$USE_SCCACHE" = "1" ]; then sccache --show-stats; fi \
    && ls /app/aiter/dist/*.whl
RUN mkdir -p /app/install && cp /app/aiter/dist/*.whl /app/install


###
### Final Build
###

# Wheel release stage - 
# only includes dependencies used by wheel release pipeline
FROM base AS debs_wheel_release
RUN mkdir /app/debs
RUN --mount=type=bind,from=build_triton,src=/app/install/,target=/install \
    cp /install/*.whl /app/debs
RUN --mount=type=bind,from=build_fa,src=/app/install/,target=/install \
    cp /install/*.whl /app/debs
RUN --mount=type=bind,from=build_amdsmi,src=/app/install/,target=/install \
    cp /install/*.whl /app/debs
RUN --mount=type=bind,from=build_pytorch,src=/app/install/,target=/install \
    cp /install/*.whl /app/debs
RUN --mount=type=bind,from=build_torchvision,src=/app/install/,target=/install \
    cp /install/*.whl /app/debs
RUN --mount=type=bind,from=build_torchaudio,src=/app/install/,target=/install \
    cp /install/*.whl /app/debs
RUN --mount=type=bind,from=build_aiter,src=/app/install/,target=/install \
    cp /install/*.whl /app/debs

# Full debs stage - includes Mori (used by Docker releases)
FROM base AS debs
RUN mkdir /app/debs
RUN --mount=type=bind,from=build_triton,src=/app/install/,target=/install \
    cp /install/*.whl /app/debs
RUN --mount=type=bind,from=build_fa,src=/app/install/,target=/install \
    cp /install/*.whl /app/debs
RUN --mount=type=bind,from=build_amdsmi,src=/app/install/,target=/install \
    cp /install/*.whl /app/debs
RUN --mount=type=bind,from=build_pytorch,src=/app/install/,target=/install \
    cp /install/*.whl /app/debs
RUN --mount=type=bind,from=build_torchvision,src=/app/install/,target=/install \
    cp /install/*.whl /app/debs
RUN --mount=type=bind,from=build_torchaudio,src=/app/install/,target=/install \
    cp /install/*.whl /app/debs
RUN --mount=type=bind,from=build_aiter,src=/app/install/,target=/install \
    cp /install/*.whl /app/debs
RUN --mount=type=bind,from=build_mori,src=/app/install/,target=/install \
    cp /install/*.whl /app/debs

# rocprofiler-sdk 1.3.2 fixes torch 2.12 profiler on ROCm 7.2.3
FROM base AS build_rocprofiler_sdk
ARG ROCPROFILER_SDK_REPO
ARG ROCPROFILER_SDK_COMMIT
ARG USE_SCCACHE
RUN apt-get update \
    && apt-get install -y --no-install-recommends libdw-dev libelf-dev libsqlite3-dev libzstd-dev \
    && rm -rf /var/lib/apt/lists/*
RUN git init -q /src && cd /src \
    && git remote add origin ${ROCPROFILER_SDK_REPO} \
    && git config core.sparseCheckout true \
    && git config remote.origin.promisor true \
    && git config remote.origin.partialclonefilter blob:none \
    && git sparse-checkout init --cone \
    && git sparse-checkout set projects/rocprofiler-sdk shared cmake \
    && git fetch --filter=blob:none --depth 1 origin ${ROCPROFILER_SDK_COMMIT} \
    && git checkout -q --detach FETCH_HEAD \
    && test "$(git rev-parse HEAD)" = "${ROCPROFILER_SDK_COMMIT}"
# Patch the ROCm 7.2.3 build of rocprofiler-sdk to include queue-interposition fixes that are
# absent from the pinned 7.14 build. This resolves hangs on torch.profiler on ROCm.
# TODO: Drop these once ${ROCPROFILER_SDK_COMMIT} is bumped to a build that already 
# contains them, such as ROCm 10.0. See https://github.com/vllm-project/vllm/issues/54087.
ARG ROCPROFILER_SDK_PR_7796=fae7fd57ffb8a76e811d6410b8a0cee1e94d710a
ARG ROCPROFILER_SDK_PR_7924=f8db22adbe17686a9b05ae03367dd1ec73011653
ARG ROCPROFILER_SDK_PR_7796_SHA256=07627e4a5139e0128a9e15f83732f96fea693b8f538846653dd5b518a0900769
ARG ROCPROFILER_SDK_PR_7924_SHA256=8c53eee9efb203fe061ae7bfcf88dfef4114c59ce7d4206ca30a3b5ef2ec121b
RUN cd /src \
    && HSA_PATHS='projects/rocprofiler-sdk/source/lib/rocprofiler-sdk/hsa/*' \
    && curl -fsSL -o /tmp/qi-7796.patch "${ROCPROFILER_SDK_REPO%.git}/commit/${ROCPROFILER_SDK_PR_7796}.patch" \
    && curl -fsSL -o /tmp/qi-7924.patch "${ROCPROFILER_SDK_REPO%.git}/commit/${ROCPROFILER_SDK_PR_7924}.patch" \
    && printf '%s  %s\n' "${ROCPROFILER_SDK_PR_7796_SHA256}" \
        /tmp/qi-7796.patch | sha256sum --check - \
    && printf '%s  %s\n' "${ROCPROFILER_SDK_PR_7924_SHA256}" \
        /tmp/qi-7924.patch | sha256sum --check - \
    && git apply -p1 --include="$HSA_PATHS" --verbose /tmp/qi-7796.patch \
    && git apply -p1 --include="$HSA_PATHS" --verbose /tmp/qi-7924.patch
RUN cd /src/projects/rocprofiler-sdk \
    && if [ "$USE_SCCACHE" = "1" ]; then \
           export CMAKE_C_COMPILER_LAUNCHER=sccache \
           && export CMAKE_CXX_COMPILER_LAUNCHER=sccache; \
       fi \
    && cmake -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_PREFIX_PATH=/opt/rocm \
        -DCMAKE_INSTALL_PREFIX=/opt/rocm \
        -DROCPROFILER_BUILD_TESTS=OFF \
        -DROCPROFILER_BUILD_SAMPLES=OFF \
        -DROCPROFILER_BUILD_DOCS=OFF \
    && cmake --build build --parallel "$(nproc)" \
    && cmake --install build --prefix /staging --strip

FROM base AS final
# AITER imports yaml at runtime but omits PyYAML from its wheel metadata.
RUN --mount=type=bind,source=requirements/build/rocm-constraints.txt,target=/tmp/rocm-constraints.txt,ro \
    --mount=type=bind,from=debs,src=/app/debs,target=/install \
    pip install --constraint /tmp/rocm-constraints.txt pyyaml /install/*.whl \
    && pip check

COPY --from=build_rocprofiler_sdk /staging/ /opt/rocm/
RUN ldconfig

ARG BASE_IMAGE
ARG TRITON_BRANCH
ARG TRITON_REPO
ARG PYTORCH_BRANCH
ARG PYTORCH_VISION_BRANCH
ARG PYTORCH_REPO
ARG PYTORCH_VISION_REPO
ARG PYTORCH_AUDIO_BRANCH
ARG PYTORCH_AUDIO_REPO
ARG FA_BRANCH
ARG FA_REPO
ARG AITER_BRANCH
ARG AITER_REPO
ARG MORI_BRANCH
ARG MORI_REPO
ARG ROCPROFILER_SDK_REPO
ARG ROCPROFILER_SDK_COMMIT
ARG ROCM_RUNTIME_REPO
ARG ROCM_RUNTIME_COMMIT
RUN echo "BASE_IMAGE: ${BASE_IMAGE}" > /app/versions.txt \
    && echo "ROCPROFILER_SDK_REPO: ${ROCPROFILER_SDK_REPO}" >> /app/versions.txt \
    && echo "ROCPROFILER_SDK_COMMIT: ${ROCPROFILER_SDK_COMMIT}" >> /app/versions.txt \
    && echo "ROCM_RUNTIME_REPO: ${ROCM_RUNTIME_REPO}" >> /app/versions.txt \
    && echo "ROCM_RUNTIME_COMMIT: ${ROCM_RUNTIME_COMMIT}" >> /app/versions.txt \
    && echo "TRITON_BRANCH: ${TRITON_BRANCH}" >> /app/versions.txt \
    && echo "TRITON_REPO: ${TRITON_REPO}" >> /app/versions.txt \
    && echo "PYTORCH_BRANCH: ${PYTORCH_BRANCH}" >> /app/versions.txt \
    && echo "PYTORCH_VISION_BRANCH: ${PYTORCH_VISION_BRANCH}" >> /app/versions.txt \
    && echo "PYTORCH_REPO: ${PYTORCH_REPO}" >> /app/versions.txt \
    && echo "PYTORCH_VISION_REPO: ${PYTORCH_VISION_REPO}" >> /app/versions.txt \
    && echo "PYTORCH_AUDIO_BRANCH: ${PYTORCH_AUDIO_BRANCH}" >> /app/versions.txt \
    && echo "PYTORCH_AUDIO_REPO: ${PYTORCH_AUDIO_REPO}" >> /app/versions.txt \
    && echo "FA_BRANCH: ${FA_BRANCH}" >> /app/versions.txt \
    && echo "FA_REPO: ${FA_REPO}" >> /app/versions.txt \
    && echo "AITER_BRANCH: ${AITER_BRANCH}" >> /app/versions.txt \
    && echo "AITER_REPO: ${AITER_REPO}" >> /app/versions.txt \
    && echo "MORI_BRANCH: ${MORI_BRANCH}" >> /app/versions.txt \
    && echo "MORI_REPO: ${MORI_REPO}" >> /app/versions.txt
